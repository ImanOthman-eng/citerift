},"params":{"1":{"wt":"beg"}},"i":0}},"\n",{"template":{"target":{"wt":"صندوق معلومات دواء \n","href":"./قالب:صندوق_معلومات_دواء"},"params":{"Watchedfields":{"wt":"changed"},"verifiedrevid":{"wt":"321803860"},"1":{"wt":"   BE AWARE THAT \"ANYONE CAN CHANGE THIS PAGE\"\n"},"width":{"wt":"250"},"IUPAC_name":{"wt":"(2&apos;&apos;S&apos;&apos;,5&apos;&apos;R&apos;&apos;,6&apos;&apos;R&apos;&apos;)- 6-{[(2&apos;&apos;R&apos;&apos;)-2-amino- 2-(4-hydroxyphenyl)- acetyl]amino}- 3,3-dimethyl- 7-oxo- 4-thia- 1-azabicyclo[3.2.0]heptane- 2-carboxylic acid"},"image":{"wt":"Amoxicillin2.svg"},"image2":{"wt":"Amoxicillin-3D-balls.png"},"CASNo_Ref":{"wt":"{{cascite}}"},"InChI":{"wt":"1/C16H19N3O5S/c1-16(2)11(15(23)24)19-13(22)10(14(19)25-16)18-12(21)9(17)7-3-5-8(20)6-4-7/h3-6,9-11,14,20H,17H2,1-2H3,(H,18,21)(H,23,24)/t9-,10-,11+,14-/m1/s1"},"InChIKey":{"wt":"LSQZJLSUYDQPKJ-NJBDSQKTBY"},"CAS_number":{"wt":"26787-78-0"},"ChemSpiderID":{"wt":"31006"},"ATC_prefix":{"wt":"J01"},"ATC_suffix":{"wt":"CA04"},"ATC_supplemental":{"wt":"{{ATCvet|G51|AX01}}"},"PubChem":{"wt":"33613"},"DrugBank":{"wt":"APRD00248"},"C":{"wt":"16"},"H":{"wt":"19"},"N":{"wt":"3"},"O":{"wt":"5"},"S":{"wt":"1"},"molecular_weight":{"wt":"365.4 g/mol"},"smiles":{"wt":"O=C(O)[C@@H]2N3C(=O)[C@@H](NC(=O)[C@@H](c1ccc(O)cc1)N)[C@H]3SC2(C)C"},"bioavailability":{"wt":"95% فموي"},"metabolism":{"wt":"أقل من 30% biotransformed in [[كبد]]"},"elimination_half-life":{"wt":"61.3 دقيقة"},"excretion":{"wt":"[[كلية|كلوي]]"},"pregnancy_AU":{"wt":"A"},"pregnancy_US":{"wt":"B"},"pregnancy_category":{"wt":""},"legal_AU":{"wt":""},"legal_UK":{"wt":"POM"},"legal_US":{"wt":""},"routes_of_administration":{"wt":"[[Wiktionary:oral|فموي]]، [[معالجة وريدية|حقن وريدي]]"}},"i":1}},"\n\n[[ملف:Amoxicillin-2D-skeletal.png|تصغير|التركيب الكيميائي]]\n[[ملف:Amoxicillin-3D-balls.png|تصغير|مجسم التركيب]]\n&apos;&apos;&apos;أموكسيسيلين&apos;&apos;&apos; (",{"template":{"target":{"wt":"اللغة","href":"./قالب:اللغة"},"params":{"1":{"wt":"en"},"2":{"wt":"Amoxicillin"}},"i":2}},") هو عقار ينتمي إلى فئة من العقاقير تسمى [[مضاد حيوي|مضادات حيوية]] مشابهة [[بنسلين|للبنسلين]]. يستعمل لمعالجة الإصابات التي تسببها أنواع معينة من [[بكتيريا|البكتيريا]]. فهو يعمل من خلال وقف نمو [[بكتيريا|البكتيريا]]. وهو [[مضاد حيوي]] متوسط الطيف، من صنف &apos;&apos;&apos;مضادات البيتالاكتام&apos;&apos;&apos;. هو ذو أفضلية على غيره من أدوية هذا الصنف لأنه يمتاز بامتصاص أفضل من [[بدن|الجسم]] عند التعاطي بالفم. أموكسيسيلين هو المضاد الحيوي الأكثر استخدامًا [[طفل|للأطفال]].\nأموكسيسيلين معرّض للتثبيط بواسطة [[بكتيريا|البكتيريا]] المنتجة للبيتالاكتاميز المقاومة للمضادات الحيوية واسعة الطيف مثل [[بنسلين|البنسيلين]]، ولهذا يتم مزجه غالبًا مع مثبط للبيتالاكتاميز (",{"template":{"target":{"wt":"اللغة","href":"./قالب:اللغة"},"params":{"1":{"wt":"en"},"2":{"wt":"beta-lactamase"}},"i":3}},") [[حمض الكلافولينيك|كحامض الكلافولينيك]]\n\nالمضادات الحيوية بشكل عام لا تصلح لعلاج نزلات البرد، والإنفلونزا، وغيرها من العدوى الفيروسية. فالأموكسيسيلين يستخدم لعلاج بعض الالتهابات التي تسببها البكتيريا، مثل [[التهاب الرئة|الالتهاب الرئوي]]، [[التهاب القصبات]]، [[سيلان (توضيح)|السيلان]]، و[[التهاب أنف أذن حنجرة|التهابات الأنف الأذن والحنجرة]]، و[[جهاز بولي|المسالك البوليه]]، و[[جلد|الجلد]]. يستخدم أيضًا مع مجموعة أدوية أخرى للقضاء على البكتيريا التي تتسبب [[قرحة (توضيح)|القرحات]]. نيليسيسكوما هو في فئة من الأدوية تسمى - مثل البنسلين والمضادات الحيوية. إنه يعمل من خلال وقف نمو البكتريا. المضادات الحيوية لن تعمل لنزلات البرد، والإنفلونزا، وغيرها من العدوى الفيروسية.\n\n== الاستخدام الطبي ==\nالأموكسيسيلين يستخدم لعلاج عدد من الأمراض المعدية: التهاب الأذن الوسطى الحاد، التهاب البلعوم بالعقيديات، التهاب الرئة، الالتهابات الجلدية، التهابات المسالك البولية، السلمونيلة، داء لايم وعدوى المتدثرة.&lt;ref name=AHFS>{{استشهاد بويب|عنوان=Amoxicillin|مسار=https://www.drugs.com/monograph/amoxicillin.html|عمل=The American Society of Health-System Pharmacists|تاريخ الوصول=3 April 2011| مسار أرشيف = https://web.archive.org/web/20190329101408/https://www.drugs.com/monograph/amoxicillin.html | تاريخ أرشيف = 29 مارس 2019 }}&lt;/ref>\nتستخدم كذلك للحيلولة دون وقوع التهاب الشغاف الجرثومي في الأشخاص أصحاب الاختطار المرتفع الذين يعالجون أسنانهم للوقاية دون عدوى العقدية الرئوية عند الذين استؤصل الطحال عندهم. وكذلك للوقاية ولعلاج الجمرة الخبيثة. رغم ذلك فإن المملكة المتحدة لا تنصح باستخدامه للتوقية من التهاب الشغاف العدوائي. لكن يبدو أن هذه التوصيات لم تغير نسبة العدوى.\n.&lt;ref>{{استشهاد بويب|عنوان=CG64 Prophylaxis against infective endocarditis: Full guidance|مسار=http://www.nice.org.uk/nicemedia/live/11938/40039/40039.pdf|عمل=NICE|تاريخ الوصول=8 June 2011| مسار أرشيف = https://web.archive.org/web/20120912122124/http://www.nice.org.uk/nicemedia/live/11938/40039/40039.pdf | تاريخ أرشيف = 12 سبتمبر 2012 |حالة المسار=dead}}&lt;/ref>&lt;ref>{{استشهاد بدورية محكمة|الأخير=Thornhill|الأول=MH|المؤلفون=Dayer, MJ, Forde, JM, Corey, GR, Chu, VH, Couper, DJ, Lockhart, PB|عنوان=Impact of the NICE guideline recommending cessation of antibiotic prophylaxis for prevention of infective endocarditis: before and after study|صحيفة=BMJ (Clinical research ed.)|تاريخ=2011-05-03|المجلد=342|صفحات=d2392|pmid=21540258|doi=10.1136/bmj.d2392|pmc=3086390}}&lt;/ref>\nأوصت الإرشادات بالأموكسيسيلين والأموكساسيلين-حمض الكلافيولينيك كأول خيار يجب استخدامه لعلاج التهاب الجيوب الأنفية البكتيري. مع أن معظم التهابات الجيوب الأنفية سببها فايروسي، والمضادات الحيوية غير فعالة مع الفايروسات. أحيانا يستخدم الأموكسيسيلين لعلاج العدوى الجلدية مثل حب الشباب. يستخدم الأموكسيسيلين عادتا لعلاج حالات حب الشباب التي لم تستجيب لمضادات حيوية أخرى مثل الدوكسيسيكلين والمينوسايكلين.\n.&lt;ref name=\"AAAAIfive\">{{استشهاد بدورية محكمة|مؤلف1 = American Academy of Allergy, Asthma, and Immunology |مؤلف1-وصلة = American Academy of Allergy, Asthma, and Immunology |تاريخ = |عنوان = Five Things Physicians and Patients Should Question |ناشر = [[American Academy of Allergy, Asthma, and Immunology]] |عمل = Choosing Wisely: an initiative of the [[اختر بحكمة]] |صفحة = |مسار = https://www.choosingwisely.org/societies/american-academy-of-allergy-asthma-immunology/ |تاريخ الوصول = August 14, 2012| مسار أرشيف = https://web.archive.org/web/20121109032537/http://choosingwisely.org/wp-content/uploads/2012/04/5things_12_factsheet_AAAAI.pdf | تاريخ أرشيف = 9 نوفمبر 2012 }}&lt;/ref>&lt;ref name=\"antibioticssinusitis\">{{استشهاد بدورية محكمة \n| الأخير1 = Ahovuo-Saloranta | الأول1 = A. \n| الأخير2 = Rautakorpi | الأول2 = U. M. \n| الأخير3 = Borisenko | الأول3 = O. V. \n| الأخير4 = Liira | الأول4 = H. \n| الأخير5 = Williams Jr | الأول5 = J. W. \n| الأخير6 = Mäkelä | الأول6 = M. \n| محرر1-الأخير = Ahovuo-Saloranta \n| محرر1-الأول = Anneli \n| الفصل = Antibiotics for acute maxillary sinusitis \n| doi = 10.1002/14651858.CD000243.pub2 \n| عنوان = Cochrane Database of Systematic Reviews \n| سنة = 2008 \n| pmid =  \n| pmc = \n}}&lt;/ref>&lt;ref>{{استشهاد بويب | عنوان = Adolescent Acne: Management | مسار = https://www.medscape.com/viewarticle/430534_5| مسار أرشيف = https://web.archive.org/web/20170612025323/http://www.medscape.com:80/viewarticle/430534_5 | تاريخ أرشيف = 12 يونيو 2017 }}&lt;/ref>&lt;ref>{{استشهاد بويب|مسار=http://www.scienceofacne.com/amoxicillin/|عنوان=Amoxicillin and Acne Vulgaris |ناشر=scienceofacne.com |تاريخ=2012-09-05 |تاريخ الوصول=2012-08-17| مسار أرشيف = https://web.archive.org/web/20170908202431/http://scienceofacne.com/amoxicillin/ | تاريخ أرشيف = 8 سبتمبر 2017 }}&lt;/ref>\n\n=== التهاب الأذن الوسطى الحاد ===\nعادةً ما يُعالج الأطفال المصابون [[التهاب الأذن الوسطى|بالتهاب الأذن الوسطى]] الحاد والذين تقل أعمارهم عن 6 أشهر بالأموكسيسيلين أو المضادات الحيوية الأخرى. على الرغم من أن معظم الأطفال المصابين بالتهاب الأذن الوسطى الحاد والذين تزيد أعمارهم عن عامين لا يستفيدون من العلاج بالأموكسيسيلين أو المضادات الحيوية الأخرى، فقد يكون هذا العلاج مفيدًا للأطفال الذين تقل أعمارهم عن عامين المصابين بالتهاب الأذن الوسطى الحاد الثنائي أو المصحوب بتصريف الأذن.&lt;ref>{{استشهاد بدورية محكمة|الأخير1=Venekamp|عنوان=Antibiotics for acute otitis media in children|pmid=26099233|doi=10.1002/14651858.CD000219.pub4|صفحات=CD000219|العدد=6|تاريخ=23 June 2015|صحيفة=Cochrane Database of Systematic Reviews|الأول5=Maroeska M|الأول1=Roderick P|الأخير5=Rovers|الأول4=Chris B|الأخير4=Del Mar|الأول3=Paul P|الأخير3=Glasziou|الأول2=Sharon L|الأخير2=Sanders|pmc=7043305}}&lt;/ref> في الماضي، كان الأموكسيسيلين يُعطى ثلاث مرات يوميًا عند استخدامه لعلاج التهاب الأذن الوسطى الحاد، مما أدى إلى فقدان الجرعات في الممارسة الإسعافية الروتينية. ومع تطور العلم والأبحاث وُجد أن الجرعة اليومية مرتين أو مرة واحدة في اليوم تؤدي نفس الفعالية.&lt;ref>{{استشهاد بدورية محكمة|عدة مؤلفين=Thanaviratananich S, Laopaiboon M, Vatanasapt P|عنوان=Once or twice daily versus three times daily amoxicillin with or without clavulanate for the treatment of acute otitis media|صحيفة=Cochrane Database Syst Rev|العدد=12|صفحات=CD004975|تاريخ=December 2013|pmid=24338106|doi=10.1002/14651858.CD004975.pub3}}&lt;/ref>\n\n=== التهابات الجهاز التنفسي ===\nأوصت الدلائل الإرشادية باستخدام أموكسيسيلين وأموكسيسيلين كلافولانات كدواء مفضل [[التهاب الجيوب|لالتهاب الجيوب الأنفية]] الجرثومي والتهابات الجهاز التنفسي الأخرى. تنتج معظم التهابات الجيوب الأنفية بسبب [[فيروس|الفيروسات]]، حيث لا يكون أموكسيسيلين وأموكسيسيلين كلافولانات فعالين (كونهمما مضادين ضد البكتيريا فقط وليس الفيروسات)، وقد يتم تجاوز الفائدة الصغيرة التي يكتسبها الأموكسيسيلين بسبب الآثار الضارة.&lt;ref name=\"antibioticssinusitis2\">{{استشهاد بدورية محكمة|الأخير1=Ahovuo-Saloranta|الأول6=M.|سنة=2014|صفحات=CD000243|العدد=2|صحيفة=The Cochrane Database of Systematic Reviews|doi=10.1002/14651858.CD000243.pub3|عنوان=Antibiotics for acute maxillary sinusitis|محرر1-الأول=Anneli|محرر1-الأخير=Ahovuo-Saloranta|الأخير6=Mäkelä|الأول1=A.|الأول5=J. W.|الأخير5=Williams Jr|الأول4=H.|الأخير4=Liira|الأول3=O. V.|الأخير3=Borisenko|الأول2=U. M.|الأخير2=Rautakorpi|pmid=24515610}} {{Retracted|doi=10.1002/14651858.cd000243.pub4}}&lt;/ref> يوصى باستخدام أموكسيسيلين كعلاج مفضل للالتهاب الرئوي المكتسب من المجتمع عند البالغين من قبل المعهد الوطني للتميز في الرعاية الصحية، إما بمفرده (إذا كان المرض خفيف إلى متوسط الخطورة) أو بالاشتراك مع عائلة الماكروليدات. توصي منظمة الصحة العالمية (WHO) باستخدام الأموكسيسيلين كخط علاج أولي [[التهاب الرئة|للالتهاب الرئوي]] غير «الشديد». يستخدم أموكسيسيلين في استنشاق الجمرة الخبيثة بعد التعرض للوقاية من تطور المرض وللوقاية.&lt;ref name=\"Davisamox\">{{استشهاد بويب\n| مسار = http://davisplus.fadavis.com/3976/meddeck/pdf/amoxicillin.pdf\n| عنوان = Amoxicillin\n| تاريخ = 2017\n| ناشر = Davis\n| مسار أرشيف = https://web.archive.org/web/20170908135951/https://davisplus.fadavis.com/3976/meddeck/pdf/amoxicillin.pdf\n| تاريخ أرشيف = September 8, 2017\n| تاريخ الوصول = March 22, 2017\n| حالة المسار = live\n}}&lt;/ref>\n=== بكتيريا المعدة الحلزونية ===\nيعد الأموكسيسيلن علاج فعال كجزء من نظام متعدد الأدوية لعلاج التهابات المعدة من [[بكتيريا المعدة الحلزونية]]. يتم دمجه عادةً مع مثبط مضخة البروتون (مثل [[أوميبرازول]]) ومضاد حيوي من عائلة [[الماكرولايدات]] (مثل [[كلاريثروميسين]])؛ وتوجد تركيبات أدوية أخرى فعالة أيضًا.&lt;ref>{{استشهاد بدورية محكمة|عدة مؤلفين=Chey WD, Leontiadis GI, Howden CW, Moss SF|عنوان=ACG Clinical Guideline: Treatment of Helicobacter pylori Infection|صحيفة=Am. J. Gastroenterol.|المجلد=112|العدد=2|صفحات=212–239|تاريخ=February 2017|pmid=28071659|doi=10.1038/ajg.2016.563|s2cid=9390953}}&lt;/ref>\n\n== الأعراض الجانبية ==\nالأعراض الجانبية مشابهة لأي مضاد بيتالاكتام آخر. الأعراض الجانبية تشمل الغثيان، التقيؤ، الطفح الجلدي والتهاب القولون المرافق للمضادات الحيوية وأحيانا الإسهال. من المضاعفات الجانبية النادرة مثل إضرابات نفسية، دوخة، أرق، التباس، قلق، الحساسية للضوؤ والصوت وإضراب في التفكير. يجب توفير الرعاية الصحية الفورة في حال ظهور أي من هذه الأعراض.\n\nقد يكون ظهور التفاعل الأرجي سريعا ومفاجئا وعند حصول ذلك يجب البحث عن رعاية طبية حثيثة في أسرع وقت ممكن. غالبا يبدأ ظهور هذا التفاعل على شكل تغير وإضراب في الحالة العقلية، طفح جلدي مع حكة شديدة (غالبا ما تبدأ عند أنامل الأصابع ومنطقة الأربية وتنتشر سريعا للأجزاء الأخرى)، الإحساس بالحمى، الغثيان والتقيؤ. يجب أخذ أي عرض آخر يظهر بجدية وإن كان بعيد العلاقة. مع ذلك فإنه قد تظهر أعراض خفيفة، كالطفح الجلدي، في أي وقت خلال فترة العلاج وحتى بعد اسبوع من توقف العلاج. لبعض الشخاص الحساسين للأموكسيسيلين الأعراض الجانبية قد تكون مميتة.\n\nاستخدام الأموكسيسيلين-حمض الكلافيولينيك لأكثر من أسبوع سبب التهاب خفيف في الكبد عند بعض المرضى. الأطفال الذين يسيؤون تعاطي الأموكسيسيلين بكميات كبيرة تظهر عليهم النوام، التقيؤ وخلل في عمل الكلى.\n\n=== الطفح الجلدي غير الأرجي للأموكسيسيلين ===\n\n3% - 10% من الأطفال الذين يأخذون الأموكسيسيلين أو الأمبيسيلين يظهر عليهم طفح جلدي مع حكة بشكل متأخر (بعد أكثر من 72 ساعة من بداية أخذة وعدم أخذ دواء مشابه للبنيلين من قبل)و أحيانا يطلق عليها «الطفح الجلدي المصاحب للأموكسيسيلين». يمكن أن يحدث هذا الطفح عند الكبار أيضا.\n\nهذا الطفح بقعي حطاطي أو حصبي الشكل (أي مثل مرض الحصبة) لذلك يطلق على الطفح «[[طفح حصبي|الطفح الحصبي]] الناجم عن الأموكسيسيلين». يبدأ الطفح على الجلد وينتشر لأنحاء أخرى من الجسم. من المستبعد أن يكون هذا الطفح تفاعل أرجي حقيقي، وهو ليس مانع لاستعمال الأموكسيسيلين في المستقبل أو حتى لإستكمال العلاج الحالي للأموكسيسيلين. مع ذلك فإن يصعب على الغير متمرس تفريق هذا التفاعل الغير أرجي من التفاعل الأرجي بسهولة. لذلك يجب الاستعانة بطبيب للتفريق بينهما.\n\nقد يكون التفاعل الغير أرجي مؤشرا على كثرة الوحيدات العدوائية، حيث تشير بعض الدراسات إلى أن 80% -90% من المصابين بعدوى فيروس ايبشتاينبار الحادة الذين تم معالجتها بالأموكسيسيلين أو الأمبيسيلين ظهر عليهم الطفح.\n\n== التاثر وتفاعل الأدوية ==\nيمكن أن يتأثر الأموكسيسيلين ويتفاعل مع مجموعات الأدوية التالية:\n* بروبنسيد\n* كلورامفينكول..تتراسيكلين\n*\tمضادة التخثر (مثل: الوارفارن، باراداكس)\n* الوبورينول\n* حبوب تنظيم النسل\n* مضادات حيوية معينة\n* علاج السرطان (ميثوتريكسات)\n* الأدوية المحفزة لبيلة حمض اليوريك\n* مطعوم التيفود\n\n== آلية العمل ==\nيثبط الأموكسيسيلين تكون جدار الخلية للبكتيريا. فهو يثبط الترابط بين سلاسل بولميرات البيبتايدوجلايكان الخطية التي تكون جزئا مهما من جدار الخلية البكتيرية موجبة الغرام وسالبة الغرام.\nلها مجموعتين قابلات للتأين في الحالة الفيزيولوجية الطبيعية.\n\n== تأثر ومقاومة البكتيريا ==\nالعصوية الرقيقة (Bacillus subtilis)، المكورة معوية (Enterococcus)، المستدمية (Haemophilus)، الملوية (Haemophilus)، الموراكسيلة (Moraxella) هي في العموم أنواع حساسة وتتأثر بالأموكسيسيلين. بينما [[ليمونية (توضيح)|الليمونية]] (Citrobacter)، الكلبسيلة (Klebsiella)، الزائفة الزنجارية (Pseudomonas aeruginosa) جميعها مقاومة للأموكساسيلين بعض الاشريكية القولونية (Escherichia coli) والعنقودية الذهبية (Staphylococcus aureus) كونت مقاومة ومناعة للأموكساسيلين على درجات متفاوتة.\n\n== مرَكبات ==\nيستخدم مع [[حمض الكلافولينيك|حامض الكلافولينيك]] للعلاج من العدوى من البكتريا التي تفرز مثبط إنزيم البيتالاكتاميز (بالإنجليزية:beta-lactamase)\n== علم الأدوية ==\nأموكسيسيلين (α-amino-p-hydroxybenzyl penicillin) هو مشتق شبه اصطناعي من [[بنسلين|البنسلين]] له هيكل مشابه لمركب [[الأمبيسيلين]] ولكن مع امتصاص أفضل عند تناوله عن طريق الفم، وبالتالي يكون تركيزه أعلى في [[دم|الدم]] والبول. ينتشر الأموكسيسيلين بسهولة في الأنسجة وسوائل الجسم. ويزيد وصوله للجهاز العصبي المركزي من [[التهاب السحايا]]. يتمكن الأموكسيسلين من اختراق المشيمة ويفرز أيضاً في حليب الأم بكميات صغيرة لذلك يجب الحذر منه بخصوص الحامل أو المرضضع ولا يعطى إلا تحت إشراف الطبيب المختص وتوصيته. يفرز في البول ويتم استقلابه عن طريق الكبد. يبدأ الأموكسيسلين عمله في الجسم خلال 30 دقيقة وله نصف عمر يبلغ 3.7 ساعة عند الأطفال حديثي الولادة و 1.4 ساعة عند البالغين.\n\n== معرض صور ==\n&lt;gallery>\nFile:Amoxicillin rash 11 hours after 17th dose.JPG\nFile:Amoxicillin rash 3 hours after 17th dose.JPG\nFile:Amoxicillin rash 26 hours after 17th dose.JPG\n&lt;/gallery>\n\n== المراجع ==\n\n",{"template":{"target":{"wt":"مراجع","href":"./قالب:مراجع"},"params":{},"i":4}},"\n",{"template":{"target":{"wt":"روابط شقيقة","href":"./قالب:روابط_شقيقة"},"params":{},"i":5}},"\n",{"template":{"target":{"wt":"مضادات حيوية","href":"./قالب:مضادات_حيوية"},"params":{},"i":6}},"\n",{"template":{"target":{"wt":"مضادات حيوية مدمرة للجدار الخلوي","href":"./قالب:مضادات_حيوية_مدمرة_للجدار_الخلوي"},"params":{},"i":7}},"\n",{"template":{"target":{"wt":"معرفات مركب كيميائي","href":"./قالب:معرفات_مركب_كيميائي"}