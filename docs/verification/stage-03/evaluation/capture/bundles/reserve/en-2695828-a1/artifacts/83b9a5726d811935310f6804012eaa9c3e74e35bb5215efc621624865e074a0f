span></span></a></sup></td></tr><tr><td colspan="2"><b>C</b>: <span class="nowrap"><a rel="mw:WikiLink" href="./TESS_Input_Catalog" title="TESS Input Catalog" class="mw-redirect">TIC</a> 28244970</span>, <span class="nowrap"><a rel="mw:WikiLink" href="./2MASS" title="2MASS">2MASS</a> J01530103+2937044</span><span style="display:none" data-plural="1"></span><sup about="#mwt97" class="mw-ref reference" id="cite_ref-SIMBADC_18-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"SIMBADC"}}'><a href="./Alpha_Trianguli#cite_note-SIMBADC-18" id="mwsA"><span class="mw-reflink-text" id="mwsQ"><span class="cite-bracket" id="mwsg">[</span>18<span class="cite-bracket" id="mwsw">]</span></span></a></sup></td></tr>
