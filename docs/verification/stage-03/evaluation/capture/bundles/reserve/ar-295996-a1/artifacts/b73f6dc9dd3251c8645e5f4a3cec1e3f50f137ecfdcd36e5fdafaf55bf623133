<td class="navigation-only" colspan="2" style="border-top: 2px #E1E1E1 dotted; font-size: 80%; background:inherit; text-align: left;"><span class="plainlinks" style="float:right;"><a rel="mw:ExtLink" href="https://ar.wikipedia.org/w/index.php?title=%D8%B2%D8%A8%D8%AF%D8%A9_(%D8%AC%D9%86%D9%8A%D9%86)&amp;action=edit&amp;section=0" class="external text" data-mw-original-href="//ar.wikipedia.org/w/index.php?title=%D8%B2%D8%A8%D8%AF%D8%A9_(%D8%AC%D9%86%D9%8A%D9%86)&amp;action=edit&amp;section=0"><span style="color:var(--color-base--hover, #555);">تعديل مصدري</span></a> - <a rel="mw:ExtLink" href="https://ar.wikipedia.org/w/index.php?title=%D8%B2%D8%A8%D8%AF%D8%A9_(%D8%AC%D9%86%D9%8A%D9%86)&amp;veaction=edit" class="external text" data-mw-original-href="//ar.wikipedia.org/w/index.php?title=%D8%B2%D8%A8%D8%AF%D8%A9_(%D8%AC%D9%86%D9%8A%D9%86)&amp;veaction=edit"><span style="color:var(--color-base--hover, #555);">تعديل</span></a></span><span typeof="mw:Entity"> </span><span typeof="mw:File" data-mw='{"caption":"طالع توثيق القالب"}'><a href="https://ar.wikipedia.org/wiki/%D9%82%D8%A7%D9%84%D8%A8:%D8%B5%D9%86%D8%AF%D9%88%D9%82_%D9%85%D8%B9%D9%84%D9%88%D9%85%D8%A7%D8%AA_%D8%AA%D8%AC%D9%85%D8%B9_%D8%B3%D9%83%D8%A7%D9%86%D9%8A" data-mw-original-href="//ar.wikipedia.org/wiki/%D9%82%D8%A7%D9%84%D8%A8:%D8%B5%D9%86%D8%AF%D9%88%D9%82_%D9%85%D8%B9%D9%84%D9%88%D9%85%D8%A7%D8%AA_%D8%AA%D8%AC%D9%85%D8%B9_%D8%B3%D9%83%D8%A7%D9%86%D9%8A" title="طالع توثيق القالب"><img resource="./ملف:Info_Simple.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Info_Simple.svg/20px-Info_Simple.svg.png?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Info_Simple.svg/40px-Info_Simple.svg.png?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="طالع توثيق القالب" data-file-width="512" data-file-height="512" data-file-type="drawing" height="12" width="12" class="mw-file-element"/></a></span></td></tr>
