<section data-mw-section-id="17" id="mwBMo"><h3 data-mw-wikitext="" id="Religion">Religion</h3>
<span class="mw-empty-elt" about="#mwt563" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"Main","href":"./Template:Main"},"params":{"1":{"wt":"Religion in Northern Cyprus"}},"i":0}}]}' id="mwBMs"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1368532237" about="#mwt564" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'/></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt563" id="mwBMw">Main article: <a rel="mw:WikiLink" href="./Religion_in_Northern_Cyprus" title="Religion in Northern Cyprus">Religion in Northern Cyprus</a></div>

<span class="mw-empty-elt" about="#mwt565" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"Further","href":"./Template:Further"},"params":{"1":{"wt":"Religion in Cyprus"},"2":{"wt":"Islam in Cyprus"}},"i":0}}]}' id="mwBM0"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1368532237" about="#mwt566" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'/></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt565" id="mwBM4">Further information: <a rel="mw:WikiLink" href="./Religion_in_Cyprus" title="Religion in Cyprus">Religion in Cyprus</a> and <a rel="mw:WikiLink" href="./Islam_in_Cyprus" title="Islam in Cyprus">Islam in Cyprus</a></div>
