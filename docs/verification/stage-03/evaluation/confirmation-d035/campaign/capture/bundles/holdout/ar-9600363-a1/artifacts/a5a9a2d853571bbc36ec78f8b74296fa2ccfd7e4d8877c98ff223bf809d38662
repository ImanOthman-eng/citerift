_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Kasr_shimon.jpg/500px-Kasr_shimon.jpg?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="640" data-file-height="775" data-file-type="bitmap" height="242" width="200" class="mw-file-element" id="mwBA"/></a><figcaption id="mwBQ">أطلال <a rel="mw:WikiLink" href="./قصر_شمعون" title="قصر شمعون" id="mwBg">قصر شمعون</a> في <a rel="mw:WikiLink" href="./الحيرة" title="الحيرة" id="mwBw">الحيرة</a>.</figcaption></figure>
<p id="mwCA"><b id="mwCQ">العباد</b> هم طائفة <a rel="mw:WikiLink" href="./مسيحيون_عرب" title="مسيحيون عرب" id="mwCg">عربية نصرانية</a> كانت تسكن <a rel="mw:WikiLink" href="./الحيرة" title="الحيرة" id="mwCw">الحيرة</a> في فترة <a rel="mw:WikiLink" href="./جاهلية" title="جاهلية" id="mwDA">ما قبل الإسلام</a> وصدر الإسلام. قيل أنهم كانوا نصارى على <a rel="mw:WikiLink" href="./المذهب_النسطوري" title="المذهب النسطوري" class="mw-redirect" id="mwDQ">المذهب النسطوري</a>، وأنهم كانوا أهل قراءة وكتابة وعلم <a rel="mw:WikiLink" href="./إنجيل" title="إنجيل" id="mwDg">بالإنجيل</a>، وكانوا يزاولون الصناعة <a rel="mw:WikiLink" href="./تجارة" title="تجارة" id="mwDw">والتجارة</a> أيضًا، وربما سموا بالعباد؛ لأنهم كانوا يعبدون الله «أو <a rel="mw:WikiLink" href="./يسوع" title="يسوع" id="mwEA">المسيح</a>».<sup about="#mwt3" class="mw-ref reference" id="cite_ref-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-1"}}'><a href="./العباد#cite_note-1" id="mwEQ"><span class="mw-reflink-text" id="mwEg"><span class="cite-bracket" id="mwEw">[</span>1<span class="cite-bracket" id="mwFA">]</span></span></a></sup></p>

<p id="mwFQ">كان العِباد جماعة <a rel="mw:WikiLink" href="./عرب_مسيحيون" title="عرب مسيحيون" class="mw-redirect" id="mwFg">عربية مسيحية</a> في مدينة <a rel="mw:WikiLink" href="./الحيرة" title="الحيرة" id="mwFw">الحيرة</a>،<sup about="#mwt4" class="mw-ref reference" id="cite_ref-FOOTNOTEBosworth2012_2-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEBosworth2012"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEBosworth2012-2"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Bosworth"},"2":{"wt":"2012"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEBosworth2012-2" id="mwGA"><span class="mw-reflink-text" id="mwGQ"><span class="cite-bracket" id="mwGg">[</span>2<span class="cite-bracket" id="mwGw">]</span></span></a></sup> خلال <a rel="mw:WikiLink" href="./العصور_القديمة_المتأخرة" title="العصور القديمة المتأخرة" class="mw-redirect" id="mwHA">العصور القديمة المتأخرة</a> وأوائل <a rel="mw:WikiLink" href="./العصور_الوسطى" title="العصور الوسطى" id="mwHQ">العصور الوسطى</a>، حين كانت المدينة جزءًا من <a rel="mw:WikiLink" href="./الإمبراطورية_الساسانية" title="الإمبراطورية الساسانية" id="mwHg">الإمبراطورية الساسانية</a> ثم من <a rel="mw:WikiLink" href="./خلافة_إسلامية" title="خلافة إسلامية" id="mwHw">الخلافة</a>. وكان العِباد من خلفيات قبلية متعددة، ولم يوحّدهم إلا انتماؤهم إلى <a rel="mw:WikiLink" href="./المسيحية" title="المسيحية" id="mwIA">المسيحية</a>، وبعد القرن السادس، إلى <a rel="mw:WikiLink" href="./كنيسة_المشرق" title="كنيسة المشرق" id="mwIQ">كنيسة المشرق</a>.</p>

<meta property="mw:PageProp/toc" data-mw='{"autoGenerated":true}' id="mwIg"/></section><section data-mw-section-id="1" id="mwIw"><h2 data-mw-wikitext="" id="المصادر"><span id=".D8.A7.D9.84.D9.85.D8.B5.D8.A7.D8.AF.D8.B1" typeof="mw:FallbackId"></span>المصادر</h2>
<p id="mwJA">توجد المصادر المكتوبة لتاريخ العِباد في <a rel="mw:WikiLink" href="./اللغة_العربية" title="اللغة العربية" id="mwJQ">العربية</a> <a rel="mw:WikiLink" href="./اللغة_السريانية" title="اللغة السريانية" id="mwJg">والسريانية</a> <a rel="mw:WikiLink" href="./اللغة_اليونانية" title="اللغة اليونانية" id="mwJw">واليونانية</a>.<sup about="#mwt7" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20103_3-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20103"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20103-3"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"3"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20103-3" id="mwKA"><span class="mw-reflink-text" id="mwKQ"><span class="cite-bracket" id="mwKg">[</span>3<span class="cite-bracket" id="mwKw">]</span></span></a></sup></p>

<p id="mwLA">وتَرِد أوسع المصادر عن العِباد باللغة العربية. وتميل هذه المصادر إلى التركيز على الملوك والشعراء، كما تهتم بالأنساب القبلية. ومنذ العصر <a rel="mw:WikiLink" href="./الدولة_العباسية" title="الدولة العباسية" id="mwLQ">العباسي</a>، مالت أيضًا إلى إضفاء صورة مثالية على الماضي السابق للإسلام، أي <a rel="mw:WikiLink" href="./جاهلية" title="جاهلية" id="mwLg">الجاهلية</a>. ومن المراجع المهمة في التراث العربي عن العِباد <a rel="mw:WikiLink" href="./ابن_الكلبي" title="ابن الكلبي" id="mwLw">هشام بن الكلبي</a>، المتوفى عام 819، الذي اطّلع على كتب العِباد وأرشيفاتهم في الحيرة. وبذلك نقل شيئًا من تصور العِباد لأنفسهم، وتاريخهم، ومدينتهم.<sup about="#mwt10" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20102_4-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20102"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20102-4"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"2"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20102-4" id="mwMA"><span class="mw-reflink-text" id="mwMQ"><span class="cite-bracket" id="mwMg">[</span>4<span class="cite-bracket" id="mwMw">]</span></span></a></sup> وتحمل دراسته المفردة عن العِباد عنوان <i id="mwNA">كنائس الحيرة وأديرتها وأنساب العِباديين</i>.<sup about="#mwt13" class="mw-ref reference" id="cite_ref-FOOTNOTETrimingham1979196_5-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETrimingham1979196"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETrimingham1979196-5"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Trimingham"},"2":{"wt":"1979"},"p":{"wt":"196"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETrimingham1979196-5" id="mwNQ"><span class="mw-reflink-text" id="mwNg"><span class="cite-bracket" id="mwNw">[</span>5<span class="cite-bracket" id="mwOA">]</span></span></a></sup> وقد استخدمها كل من <a rel="mw:WikiLink" href="./محمد_بن_جرير_الطبري" title="محمد بن جرير الطبري" id="mwOQ">محمد بن جرير الطبري</a> <a rel="mw:WikiLink" href="./أبو_الفرج_الأصفهاني" title="أبو الفرج الأصفهاني" id="mwOg">وأبي الفرج الأصفهاني</a> مصدرًا رئيسيًا لهما عن الحيرة.<sup about="#mwt16" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20102_4-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20102"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20102-4"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"2"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20102-4" id="mwOw"><span class="mw-reflink-text" id="mwPA"><span class="cite-bracket" id="mwPQ">[</span>4<span class="cite-bracket" id="mwPg">]</span></span></a></sup></p>

<p id="mwPw">كما أسهم <a rel="mw:WikiLink" href="./تراث_شفهي" title="تراث شفهي" id="mwQA">التراث الشفهي</a> في التأريخ العربي. ففي القرن الثاني عشر، كتب <a rel="mw:WikiLink" href="./أبو_البقاء_هبة_الله_الحلي?action=edit&amp;redlink=1" title="أبو البقاء هبة الله الحلي" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["أبو البقاء هبة الله الحلي"]}}' id="mwQQ">أبو البقاء</a> من <a rel="mw:WikiLink" href="./الحلة" title="الحلة" id="mwQg">الحلة</a> أن تاريخ <a rel="mw:WikiLink" href="./مناذرة" title="مناذرة" id="mwQw">السلالة اللخمية</a>، التي حكمت المنطقة قبل الإسلام، كان يُدرَّس لتلاميذ المدارس.<sup about="#mwt19" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20102_4-2" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20102"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20102-4"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"2"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20102-4" id="mwRA"><span class="mw-reflink-text" id="mwRQ"><span class="cite-bracket" id="mwRg">[</span>4<span class="cite-bracket" id="mwRw">]</span></span></a></sup></p>

<p id="mwSA">أما <a rel="mw:WikiLink" href="./مسيحية_سريانية" title="مسيحية سريانية" id="mwSQ">المصادر السريانية</a>، فكلها كنسية.<sup about="#mwt22" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20102_4-3" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20102"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20102-4"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"2"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20102-4" id="mwSg"><span class="mw-reflink-text" id="mwSw"><span class="cite-bracket" id="mwTA">[</span>4<span class="cite-bracket" id="mwTQ">]</span></span></a></sup> وتختلف اهتماماتها وميولها تمامًا عن اهتمامات التأريخ العربي الإسلامي. فهي لا تهتم إلا بالقديسين والرجال المقدسين ورجال الدين، وغالبًا ما تبالغ في تصوير معاناتهم.<sup about="#mwt25" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20103_3-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20103"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20103-3"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"3"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20103-3" id="mwTg"><span class="mw-reflink-text" id="mwTw"><span class="cite-bracket" id="mwUA">[</span>3<span class="cite-bracket" id="mwUQ">]</span></span></a></sup></p>

<p id="mwUg">ولا تزال <a rel="mw:WikiLink" href="./علم_الآثار" title="علم الآثار" id="mwUw">آثار</a> منطقة الحيرة ودراسة عمارة <a rel="mw:WikiLink" href="./كنيسة_المشرق" title="كنيسة المشرق" id="mwVA">كنيسة المشرق</a> غير مستكشفة بما يكفي ومحدودة التطور. وعلى الرغم من أن المصادر العربية والسريانية تذكر أسماء كنائس وأديرة كثيرة مرتبطة بالعِباد، لم يُحدَّد أي منها حتى الآن تحديدًا مؤكدًا مع أي أطلال قائمة.<sup about="#mwt28" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201012_6-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201012"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201012-6"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"12"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201012-6" id="mwVQ"><span class="mw-reflink-text" id="mwVg"><span class="cite-bracket" id="mwVw">[</span>6<span class="cite-bracket" id="mwWA">]</span></span></a></sup></p>

</section><section data-mw-section-id="2" id="mwWQ"><h2 data-mw-wikitext="" id="الاسم_والانتماء_القبلي"><span id=".D8.A7.D9.84.D8.A7.D8.B3.D9.85_.D9.88.D8.A7.D9.84.D8.A7.D9.86.D8.AA.D9.85.D8.A7.D8.A1_.D8.A7.D9.84.D9.82.D8.A8.D9.84.D9.8A" typeof="mw:FallbackId"></span>الاسم والانتماء القبلي</h2>
<figure class="mw-halign-left" typeof="mw:File/Thumb" id="mwWg"><a href="./ملف:Hira_Ruined_Entry.jpg" class="mw-file-description" id="mwWw"><img resource="./ملف:Hira_Ruined_Entry.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Hira_Ruined_Entry.jpg/250px-Hira_Ruined_Entry.jpg?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Hira_Ruined_Entry.jpg/500px-Hira_Ruined_Entry.jpg?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="504" data-file-height="628" data-file-type="bitmap" height="249" width="200" class="mw-file-element" id="mwXA"/></a><figcaption id="mwXQ">أنقاض أحد المباني في مدينة <a rel="mw:WikiLink" href="./الحيرة" title="الحيرة" id="mwXg">الحيرة</a>.</figcaption></figure>
<p id="mwXw">تعني الكلمة <a rel="mw:WikiLink" href="./اللغة_العربية" title="اللغة العربية" id="mwYA">العربية</a> عبيد «الخدم» أو «المتعبّدين».<sup about="#mwt31" class="mw-ref reference" id="cite_ref-FOOTNOTETakahashi2011b_7-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETakahashi2011b"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETakahashi2011b-7"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Takahashi"},"2":{"wt":"2011b"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETakahashi2011b-7" id="mwYQ"><span class="mw-reflink-text" id="mwYg"><span class="cite-bracket" id="mwYw">[</span>7<span class="cite-bracket" id="mwZA">]</span></span></a></sup> وهي جمع كلمة <a rel="mw:WikiLink" href="./عبد_(اسم)" title="عبد (اسم)" id="mwZQ">عبد</a>، التي قد تعني خادمًا، أي خادمًا لله، أو عبدًا. وفي <a rel="mw:WikiLink" href="./القرآن" title="القرآن" id="mwZg">القرآن</a>، تكافئ الكلمة صيغة الجمع عبيد، وإن كان الاستعمال اللاحق قد خصّ العباد بخَدَم الله، وبالعبيد.<sup about="#mwt34" class="mw-ref reference" id="cite_ref-FOOTNOTEBrockopp2018_8-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEBrockopp2018"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEBrockopp2018-8"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Brockopp"},"2":{"wt":"2018"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEBrockopp2018-8" id="mwZw"><span class="mw-reflink-text" id="mwaA"><span class="cite-bracket" id="mwaQ">[</span>8<span class="cite-bracket" id="mwag">]</span></span></a></sup></p>

<p id="mwaw">ومن المرجح أن تكون كلمة عبيد اختصارًا لعبارة عبد الرب، أي «عبيد الرب»،<sup about="#mwt37" class="mw-ref reference" id="cite_ref-FOOTNOTETrimingham1979156_9-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETrimingham1979156"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETrimingham1979156-9"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Trimingham"},"2":{"wt":"1979"},"p":{"wt":"156"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETrimingham1979156-9" id="mwbA"><span class="mw-reflink-text" id="mwbQ"><span class="cite-bracket" id="mwbg">[</span>9<span class="cite-bracket" id="mwbw">]</span></span></a></sup> أو عبد المسيح، أي «خَدَم المسيح»،<sup about="#mwt40" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201011_10-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201011"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201011-10"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"11"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201011-10" id="mwcA"><span class="mw-reflink-text" id="mwcQ"><span class="cite-bracket" id="mwcg">[</span>10<span class="cite-bracket" id="mwcw">]</span></span></a></sup> أو عبد الله، أي «عباد الله»،<sup about="#mwt43" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201011_10-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201011"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201011-10"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"11"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201011-10" id="mwdA"><span class="mw-reflink-text" id="mwdQ"><span class="cite-bracket" id="mwdg">[</span>10<span class="cite-bracket" id="mwdw">]</span></span></a></sup> وهي عبارة تعكس إحساسًا بأنهم العابدون الحقيقيون الوحيدون لله.<sup about="#mwt46" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201011_10-2" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201011"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201011-10"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"11"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201011-10" id="mweA"><span class="mw-reflink-text" id="mweQ"><span class="cite-bracket" id="mweg">[</span>10<span class="cite-bracket" id="mwew">]</span></span></a></sup> ويبدو أنها كانت تسمية ذاتية لمسيحيي الحيرة.<sup about="#mwt49" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201011_10-3" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201011"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201011-10"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"11"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201011-10" id="mwfA"><span class="mw-reflink-text" id="mwfQ"><span class="cite-bracket" id="mwfg">[</span>10<span class="cite-bracket" id="mwfw">]</span></span></a></sup> ومع أن المصطلح في <a rel="mw:WikiLink" href="./أدب_إسلامي" title="أدب إسلامي" id="mwgA">الأدب الإسلامي</a> اللاحق كان يشير عادةً إلى مسيحيي الحيرة حصرًا، فقد استُخدم أحيانًا مرادفًا للمسيحيين عمومًا، كما في عبارة «مسيحيو تميم»، الواردة في <a rel="mw:WikiLink" href="./كتاب_الأغاني" title="كتاب الأغاني" id="mwgQ">كتاب الأغاني</a> <a rel="mw:WikiLink" href="./أبو_الفرج_الأصفهاني" title="أبو الفرج الأصفهاني" id="mwgg">لأبو الفرج الأصفهاني</a>،<sup about="#mwt52" class="mw-ref reference" id="cite_ref-FOOTNOTETrimingham1979156_9-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETrimingham1979156"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETrimingham1979156-9"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Trimingham"},"2":{"wt":"1979"},"p":{"wt":"156"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETrimingham1979156-9" id="mwgw"><span class="mw-reflink-text" id="mwhA"><span class="cite-bracket" id="mwhQ">[</span>9<span class="cite-bracket" id="mwhg">]</span></span></a></sup> أو للدلالة على مسيحيي <a rel="mw:WikiLink" href="./كنيسة_المشرق" title="كنيسة المشرق" id="mwhw">كنيسة المشرق</a>، كما حين يميّز <a rel="mw:WikiLink" href="./ابن_عساكر" title="ابن عساكر" id="mwiA">ابن عساكر</a>، المتوفى عام 1175، بين الكنائس التي كانت سابقًا «<a rel="mw:WikiLink" href="./الكنيسة_السريانية_الأرثوذكسية" title="الكنيسة السريانية الأرثوذكسية" id="mwiQ">يعقوبية</a>» و«كنائس العِباد» في <a rel="mw:WikiLink" href="./دمشق" title="دمشق" id="mwig">دمشق</a>.<sup about="#mwt55" class="mw-ref reference" id="cite_ref-FOOTNOTETakahashi2011a_11-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETakahashi2011a"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETakahashi2011a-11"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Takahashi"},"2":{"wt":"2011a"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETakahashi2011a-11" id="mwiw"><span class="mw-reflink-text" id="mwjA"><span class="cite-bracket" id="mwjQ">[</span>11<span class="cite-bracket" id="mwjg">]</span></span></a></sup></p>

<p id="mwjw">كان العِباد من خلفيات قبلية متعددة، من شمال الجزيرة العربية، مثل <a rel="mw:WikiLink" href="./بنو_تميم" title="بنو تميم" id="mwkA">تميم</a> <a rel="mw:WikiLink" href="./ربيعة_(قبيلة)" title="ربيعة (قبيلة)" id="mwkQ">وربيعة</a> <a rel="mw:WikiLink" href="./مضر" title="مضر" id="mwkg">ومضر</a>، ومن جنوبها، مثل <a rel="mw:WikiLink" href="./الأزد" title="الأزد" class="mw-redirect" id="mwkw">الأزد</a> <a rel="mw:WikiLink" href="./إياد_(قبيلة)" title="إياد (قبيلة)" id="mwlA">وإياد</a> <a rel="mw:WikiLink" href="./لخم" title="لخم" class="mw-redirect" id="mwlQ">ولخم</a>. وكان من العِباد من يرجع بنسبه إلى بني علقمة، وبني أيوب، وبني بقيلة من الأزد، <a rel="mw:WikiLink" href="./بنو_كعب" title="بنو كعب" id="mwlg">وبني كعب</a>، وبني عقيل، بل وإلى بني مارينة، وهم الفرع نفسه الذي تنتمي إليه الأسرة الملكية اللخمية.<sup about="#mwt58" class="mw-ref reference" id="cite_ref-FOOTNOTETrimingham1979171_12-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETrimingham1979171"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETrimingham1979171-12"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Trimingham"},"2":{"wt":"1979"},"p":{"wt":"171"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETrimingham1979171-12" id="mwlw"><span class="mw-reflink-text" id="mwmA"><span class="cite-bracket" id="mwmQ">[</span>12<span class="cite-bracket" id="mwmg">]</span></span></a></sup><sup about="#mwt61" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20104_13-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20104"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20104-13"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"4"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20104-13" id="mwmw"><span class="mw-reflink-text" id="mwnA"><span class="cite-bracket" id="mwnQ">[</span>13<span class="cite-bracket" id="mwng">]</span></span></a></sup> وكان في الحيرة مسيحيون بارزون من <a rel="mw:WikiLink" href="./طيء" title="طيء" id="mwnw">طيء</a>، لكن ليس واضحًا ما إذا كانوا يُعدّون من العِباد.<sup about="#mwt64" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20104_13-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20104"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20104-13"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"4"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20104-13" id="mwoA"><span class="mw-reflink-text" id="mwoQ"><span class="cite-bracket" id="mwog">[</span>13<span class="cite-bracket" id="mwow">]</span></span></a></sup> أما الاسم السرياني للعِباد، عُقيلة، فمشتق من القبيلة البارزة <a rel="mw:WikiLink" href="./بنو_عقيل" title="بنو عقيل" id="mwpA">بني عقيل</a>.<sup about="#mwt67" class="mw-ref reference" id="cite_ref-FOOTNOTETrimingham1979171_12-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETrimingham1979171"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETrimingham1979171-12"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Trimingham"},"2":{"wt":"1979"},"p":{"wt":"171"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETrimingham1979171-12" id="mwpQ"><span class="mw-reflink-text" id="mwpg"><span class="cite-bracket" id="mwpw">[</span>12<span class="cite-bracket" id="mwqA">]</span></span></a></sup> وعندما بدأت المسيحية تنتشر من الحيرة إلى <a rel="mw:WikiLink" href="./بلاد_بابل" title="بلاد بابل" id="mwqQ">بلاد بابل</a>، سُمّيت إحدى المستوطنات المسيحية المبكرة عَقولا نسبةً إلى القبيلة.<sup about="#mwt70" class="mw-ref reference" id="cite_ref-FOOTNOTETrimingham1979171_12-2" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETrimingham1979171"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETrimingham1979171-12"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Trimingham"},"2":{"wt":"1979"},"p":{"wt":"171"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETrimingham1979171-12" id="mwqg"><span class="mw-reflink-text" id="mwqw"><span class="cite-bracket" id="mwrA">[</span>12<span class="cite-bracket" id="mwrQ">]</span></span></a></sup> وبما أن العِباد كانوا وحدة تشكلت من عدة قبائل، فقد قال <a rel="mw:WikiLink" href="./إسماعيل_بن_حماد_الجوهري" title="إسماعيل بن حماد الجوهري" id="mwrg">الجوهري</a> إنهم حصلوا على <a rel="mw:WikiLink" href="./نسبة_(أسماء)?action=edit&amp;redlink=1" title="نسبة (أسماء)" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["نسبة (أسماء)"]}}' id="mwrw">نِسبة</a> خاصة بهم، وهي لقب يدل عادةً على الانتماء القبلي: العِبادي.<sup about="#mwt73" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20104_13-2" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20104"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20104-13"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"4"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20104-13" id="mwsA"><span class="mw-reflink-text" id="mwsQ"><span class="cite-bracket" id="mwsg">[</span>13<span class="cite-bracket" id="mwsw">]</span></span></a></sup></p>

<p id="mwtA">وعمومًا، يبدو أن مصطلح عباد لم يكن يشير إلا إلى السكان المسيحيين المستقرين الراسخين، ذوي الخلفيات القبلية المختلطة، في الحيرة. أما مسيحيو القبائل <a rel="mw:WikiLink" href="./بدو" title="بدو" id="mwtQ">البدوية</a> شبه الرحل المجاورة، فلم يكونوا يُسمّون عادةً عِبادًا، وكذلك لم يكن الوافدون المسيحيون الجدد إلى الحيرة يُسمّون بهذا الاسم. ويقول أبو البقاء صراحةً إن العِباد كانوا «أشراف أهل الحيرة، أهل البيوتات».<sup about="#mwt76" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20105_14-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20105"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20105-14"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"5"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20105-14" id="mwtg"><span class="mw-reflink-text" id="mwtw"><span class="cite-bracket" id="mwuA">[</span>14<span class="cite-bracket" id="mwuQ">]</span></span></a></sup></p>

</section><section data-mw-section-id="3" id="mwug"><h2 data-mw-wikitext="" id="اللغة_والثقافة"><span id=".D8.A7.D9.84.D9.84.D8.BA.D8.A9_.D9.88.D8.A7.D9.84.D8.AB.D9.82.D8.A7.D9.81.D8.A9" typeof="mw:FallbackId"></span>اللغة والثقافة</h2>
<p id="mwuw">كان العِباد جماعة عريقة القدم، وجزءًا من جماعة مسيحية أوسع في جنوبي بلاد الرافدين والإمبراطورية الساسانية، تطورت على نحو مستقل عن الاتجاهات السائدة داخل <a rel="mw:WikiLink" href="./الإمبراطورية_الرومانية" title="الإمبراطورية الرومانية" id="mwvA">الإمبراطورية الرومانية</a>.<sup about="#mwt79" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201013_15-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201013"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201013-15"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"13"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201013-15" id="mwvQ"><span class="mw-reflink-text" id="mwvg"><span class="cite-bracket" id="mwvw">[</span>15<span class="cite-bracket" id="mwwA">]</span></span></a></sup></p>

<p id="mwwQ">كانت العربية اللغة الأولى للعِباد، لكن لباسهم وعاداتهم كانت أقرب إلى فلاحي <a rel="mw:WikiLink" href="./آراميون" title="آراميون" id="mwwg">الناطقين بالآرامية</a> في <a rel="mw:WikiLink" href="./سواد_العراق" title="سواد العراق" id="mwww">السواد</a>، أي الأرض الخصبة في جنوبي بلاد الرافدين. وتذكر التقاليد الإسلامية اللاحقة أن <a rel="mw:WikiLink" href="./الفتح_الإسلامي_لفارس" title="الفتح الإسلامي لفارس" id="mwxA">الفاتحين العرب لبلاد الرافدين</a> وجدوا بعض الصعوبة في تقبّل العِباد بوصفهم عربًا مثلهم. وتروي إحدى الروايات أن عِباديًا وصف قومه بأنهم «عرب عاربة وعرب متعرّبة»، أي مزيج من <a rel="mw:WikiLink" href="./قحطانيون" title="قحطانيون" id="mwxQ">القحطانيين</a> الجنوبيين <a rel="mw:WikiLink" href="./عدنانيون" title="عدنانيون" id="mwxg">والعدنانيين</a> الشماليين.<sup about="#mwt82" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20106_16-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20106"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20106-16"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"6"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20106-16" id="mwxw"><span class="mw-reflink-text" id="mwyA"><span class="cite-bracket" id="mwyQ">[</span>16<span class="cite-bracket" id="mwyg">]</span></span></a></sup> وتروي رواية أخرى أن العِبادي الأسطوري <a rel="mw:WikiLink" href="./عبد_المسيح_بن_بقيلة?action=edit&amp;redlink=1" title="عبد المسيح بن بقيلة" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["عبد المسيح بن بقيلة"]}}' id="mwyw">عبد المسيح بن بقيلة</a> قال: «نحن عرب استنبطنا ونبط استعربنا». وتُظهر هذه الروايات أن العِباد قُبلوا عربًا لدى العرب الآخرين، إلى حد كبير لأن لغتهم الأولى كانت العربية.<sup about="#mwt85" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20107_17-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20107"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20107-17"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"7"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20107-17" id="mwzA"><span class="mw-reflink-text" id="mwzQ"><span class="cite-bracket" id="mwzg">[</span>17<span class="cite-bracket" id="mwzw">]</span></span></a></sup></p>

<p id="mw0A">وتشير التنقيبات الأثرية إلى أن عمارة كنائس العِباد كانت تنتمي إلى تقاليد <a rel="mw:WikiLink" href="./عمارة_بلاد_ما_بين_النهرين" title="عمارة بلاد ما بين النهرين" id="mw0Q">عمارة بلاد الرافدين</a> <a rel="mw:WikiLink" href="./عمارة_ساسانية" title="عمارة ساسانية" id="mw0g">والعمارة الساسانية</a>، مع تأثير محدود من <a rel="mw:WikiLink" href="./عمارة_بيزنطية" title="عمارة بيزنطية" id="mw0w">العمارة الرومانية الشرقية</a>. ويوجد هذا النمط من عمارة الكنائس في أنحاء <a rel="mw:WikiLink" href="./بلاد_بابل" title="بلاد بابل" id="mw1A">بلاد بابل</a> <a rel="mw:WikiLink" href="./المسيحية_في_شبه_الجزيرة_العربية_قبل_الإسلام" title="المسيحية في شبه الجزيرة العربية قبل الإسلام" id="mw1Q">والخليج العربي</a>.<sup about="#mwt88" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201012–13_18-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201012–13"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201012–13-18"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"pp":{"wt":"12–13"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201012–13-18" id="mw1g"><span class="mw-reflink-text" id="mw1w"><span class="cite-bracket" id="mw2A">[</span>18<span class="cite-bracket" id="mw2Q">]</span></span></a></sup></p>

<p id="mw2g">وقد قيل إن العِباد طوّروا أصل <a rel="mw:WikiLink" href="./الخط_الكوفي" title="الخط الكوفي" class="mw-redirect" id="mw2w">الخط الكوفي</a> في عصور ما قبل الإسلام. ويرجع التراث الإسلامي المبكر، كما في <a rel="mw:WikiLink" href="./كتاب_الأغاني" title="كتاب الأغاني" id="mw3A">كتاب الأغاني</a>، هذا الخط إلى الحيرة.<sup about="#mwt91" class="mw-ref reference" id="cite_ref-FOOTNOTETrimingham1979225–228_19-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETrimingham1979225–228"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETrimingham1979225–228-19"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Trimingham"},"2":{"wt":"1979"},"pp":{"wt":"225–228"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETrimingham1979225–228-19" id="mw3Q"><span class="mw-reflink-text" id="mw3g"><span class="cite-bracket" id="mw3w">[</span>19<span class="cite-bracket" id="mw4A">]</span></span></a></sup></p>

</section><section data-mw-section-id="4" id="mw4Q"><h2 data-mw-wikitext="" id="التاريخ"><span id=".D8.A7.D9.84.D8.AA.D8.A7.D8.B1.D9.8A.D8.AE" typeof="mw:FallbackId"></span>التاريخ</h2>
<figure class="mw-halign-left" typeof="mw:File/Thumb" id="mw4g"><a href="./ملف:Hunayn_ibn-Ishaq_al-'Ibadi_Isagoge.jpg" class="mw-file-description" id="mw4w"><img resource="./ملف:Hunayn_ibn-Ishaq_al-'Ibadi_Isagoge.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Hunayn_ibn-Ishaq_al-%27Ibadi_Isagoge.jpg/250px-Hunayn_ibn-Ishaq_al-%27Ibadi_Isagoge.jpg?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//upload.wikimedia.org/wikipedia/commons/1/14/Hunayn_ibn-Ishaq_al-%27Ibadi_Isagoge.jpg?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x" data-file-width="400" data-file-height="354" data-file-type="bitmap" height="177" width="200" class="mw-file-element" id="mw5A"/></a><figcaption id="mw5Q">رسم من مخطوط يرتبط بتقليد <a rel="mw:WikiLink" href="./حنين_بن_إسحاق" title="حنين بن إسحاق" id="mw5g">حنين بن إسحاق</a>، وهو من أبرز مترجمي العلوم في العصر العباسي.<sup about="#mwt94" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201015–16_20-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201015–16"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201015–16-20"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"pp":{"wt":"15–16"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201015–16-20" id="mw5w"><span class="mw-reflink-text" id="mw6A"><span class="cite-bracket" id="mw6Q">[</span>20<span class="cite-bracket" id="mw6g">]</span></span></a></sup></figcaption></figure>
<p id="mw6w">بحسب التقليد السرياني، وصلت <a rel="mw:WikiLink" href="./المسيحية" title="المسيحية" id="mw7A">المسيحية</a> إلى منطقة <a rel="mw:WikiLink" href="./الحيرة" title="الحيرة" id="mw7Q">الحيرة</a> على يد ناسك يُدعى عبد يشوع في القرن الثالث. ويُقال إنه أسس أول دير في الحيرة، ربما بوصفه صومعة نسكية.<sup about="#mwt97" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201013_15-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201013"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201013-15"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"13"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201013-15" id="mw7g"><span class="mw-reflink-text" id="mw7w"><span class="cite-bracket" id="mw8A">[</span>15<span class="cite-bracket" id="mw8Q">]</span></span></a></sup> وبحلول نهاية القرن الثالث، أصبح معسكر الحيرة عاصمة <a rel="mw:WikiLink" href="./مناذرة" title="مناذرة" id="mw8g">اللخميين</a>، الذين حوّلوها إلى مركز تجاري مهم. وبحلول القرن الخامس، كانت الجماعة الغالبة فيها هي المسيحيين الذين كانوا يسمّون أنفسهم العِباد.<sup about="#mwt100" class="mw-ref reference" id="cite_ref-FOOTNOTETakahashi2011b_7-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETakahashi2011b"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETakahashi2011b-7"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Takahashi"},"2":{"wt":"2011b"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETakahashi2011b-7" id="mw8w"><span class="mw-reflink-text" id="mw9A"><span class="cite-bracket" id="mw9Q">[</span>7<span class="cite-bracket" id="mw9g">]</span></span></a></sup> ويقول أبو البقاء، في القرن الثاني عشر، إن العِباد «شكّلوا الأغلبية» في الحيرة.<sup about="#mwt103" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20105_14-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20105"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20105-14"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"5"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20105-14" id="mw9w"><span class="mw-reflink-text" id="mw-A"><span class="cite-bracket" id="mw-Q">[</span>14<span class="cite-bracket" id="mw-g">]</span></span></a></sup> وقد وصلوا إليها في سلسلة من الهجرات من <a rel="mw:WikiLink" href="./شرق_شبه_الجزيرة_العربية?action=edit&amp;redlink=1" title="شرق شبه الجزيرة العربية" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["شرق شبه الجزيرة العربية"]}}' id="mw-w">شرق شبه الجزيرة العربية</a> <a rel="mw:WikiLink" href="./اليمامة" title="اليمامة" class="mw-redirect mw-disambig" id="mw_A">واليمامة</a> في وسط الجزيرة العربية.<sup about="#mwt106" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff20107_17-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff20107"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff20107-17"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"7"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff20107-17" id="mw_Q"><span class="mw-reflink-text" id="mw_g"><span class="cite-bracket" id="mw_w">[</span>17<span class="cite-bracket" id="mwAQA">]</span></span></a></sup></p>

<p id="mwAQE">ويَرِد أول ذكر موثق لأسقف الحيرة، واسمه هوشع، في أعمال مجمع سلوقية-قطسيفون عام 410. وكانت الأسقفية تابعة <a rel="mw:WikiLink" href="./مقاطعة_سلوقية_قطسيفون_البطريركية" title="مقاطعة سلوقية قطسيفون البطريركية" id="mwAQI">للمقاطعة البطريركية</a>.<sup about="#mwt109" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201013_15-2" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201013"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201013-15"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"13"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201013-15" id="mwAQM"><span class="mw-reflink-text" id="mwAQQ"><span class="cite-bracket" id="mwAQU">[</span>15<span class="cite-bracket" id="mwAQY">]</span></span></a></sup> وفي <a rel="mw:WikiLink" href="./مجمع_بيت_لافاط?action=edit&amp;redlink=1" title="مجمع بيت لافاط" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["مجمع بيت لافاط"]}}' id="mwAQc">مجمع عام 484</a>، تبنّت كنيسة المشرق <a rel="mw:WikiLink" href="./مونوفيزية" title="مونوفيزية" id="mwAQg">ثنائية الطبيعة</a>، أي النسطورية، غير أن العقيدة السائدة في الحيرة غير مؤكدة. وكان المبشرون <a rel="mw:WikiLink" href="./مونوفيزية" title="مونوفيزية" id="mwAQk">المونوفيزيون</a>، أو اليعاقبة، نشطين بين القبائل العربية حول المدينة. وفي أوائل القرن السادس، حوّل <a rel="mw:WikiLink" href="./أحوديمه" title="أحوديمه" id="mwAQo">أحوديمه</a> <a rel="mw:WikiLink" href="./تنوخ" title="تنوخ" class="mw-redirect" id="mwAQs">تنوخ</a> وعرب <a rel="mw:WikiLink" href="./الكوفة" title="الكوفة" id="mwAQw">الكوفة</a> إلى المسيحية، وكان <a rel="mw:WikiLink" href="./سمعان_بيت_أرشام" title="سمعان بيت أرشام" id="mwAQ0">سمعان بيت أرشام</a> يمارس التبشير بنشاط في الحيرة نفسها. كما اعتنقت <a rel="mw:WikiLink" href="./تغلب" title="تغلب" id="mwAQ4">تغلب</a> المونوفيزية، بل إن وثنيي واحة عين النمر اعتنقوا الفانتاسية.<sup about="#mwt112" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201015–16_20-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201015–16"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201015–16-20"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"pp":{"wt":"15–16"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201015–16-20" id="mwAQ8"><span class="mw-reflink-text" id="mwARA"><span class="cite-bracket" id="mwARE">[</span>20<span class="cite-bracket" id="mwARI">]</span></span></a></sup></p>

<p id="mwARM">ويبدو أن العِباد كانوا مختلطين عقائديًا قبل أواخر القرن السادس، حين تغلّب التأثير الثنائي الطبيعة على المونوفيزية. وكان إغلاق <a rel="mw:WikiLink" href="./مدرسة_نصيبين" title="مدرسة نصيبين" id="mwARQ">مدرسة نصيبين</a> ذات الاتجاه الثنائي الطبيعة عام 540 عاملًا حاسمًا، إذ أعاد بعض طلابها السابقين تأسيسها في الحيرة. وفي الفترة نفسها تقريبًا، يبدو أنه حدث نزوح للمونوفيزيين من الحيرة إلى <a rel="mw:WikiLink" href="./مسيحيو_نجران" title="مسيحيو نجران" id="mwARU">نجران</a>.<sup about="#mwt115" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201017_21-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201017"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201017-21"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"17"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201017-21" id="mwARY"><span class="mw-reflink-text" id="mwARc"><span class="cite-bracket" id="mwARg">[</span>21<span class="cite-bracket" id="mwARk">]</span></span></a></sup></p>

<p id="mwARo">وفي عهد <a rel="mw:WikiLink" href="./كسرى_الأول" title="كسرى الأول" id="mwARs">كسرى الأول</a>، بين عامي 531 و579، والأسقف أفرام، أُسس <a rel="mw:WikiLink" href="./دير_هند_الكبرى" title="دير هند الكبرى" id="mwARw">دير هند الكبرى</a> في الحيرة. وهو الدير الوحيد الذي حُفظ نقش تأسيسه. وقد نسخه هشام بن الكلبي. ويذكر النقش أن الكنيسة أسستها هند بنت الحارث، زوجة الملك اللخمي <a rel="mw:WikiLink" href="./المنذر_بن_امرئ_القيس" title="المنذر بن امرئ القيس" id="mwAR0">المنذر الثالث بن النعمان</a>، 503–554، وأم الملك <a rel="mw:WikiLink" href="./عمرو_بن_المنذر" title="عمرو بن المنذر" id="mwAR4">عمرو الثالث بن المنذر</a>، 554–570.<sup about="#mwt118" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201014–15_22-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201014–15"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201014–15-22"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"pp":{"wt":"14–15"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201014–15-22" id="mwAR8"><span class="mw-reflink-text" id="mwASA"><span class="cite-bracket" id="mwASE">[</span>22<span class="cite-bracket" id="mwASI">]</span></span></a></sup></p>

<p id="mwASM">وحول عام 592، اعتنق الملك اللخمي <a rel="mw:WikiLink" href="./النعمان_بن_المنذر" title="النعمان بن المنذر" id="mwASQ">النعمان الثالث بن المنذر</a> النسطورية. وبحسب رواية يكررها أبو البقاء، مرض الملك وطلب المساعدة من <a rel="mw:WikiLink" href="./الكنيسة_السريانية_الأرثوذكسية" title="الكنيسة السريانية الأرثوذكسية" id="mwASU">اليعاقبة</a>، ومن <a rel="mw:WikiLink" href="./النساطرة" title="النساطرة" class="mw-redirect" id="mwASY">النساطرة</a>. ولم تفلح صلوات اليعاقبة في شفائه، فطلب النساطرة منه أن يتحول إلى مذهبهم. وقد جرى ذلك في احتفال علني، ومع ذلك كان لا بد من استدعاء رئيس أساقفة الموصل وأربيل ليجري طقس طرد الأرواح. وتمثل هذه القصة على الأرجح جزءًا من أسطورة أصل العِباد في زمن أبي البقاء، إذ تفسر كيف حلّت الوحدة المذهبية محل التنوع المذهبي في المدينة.<sup about="#mwt121" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201017_21-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201017"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201017-21"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"17"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201017-21" id="mwASc"><span class="mw-reflink-text" id="mwASg"><span class="cite-bracket" id="mwASk">[</span>21<span class="cite-bracket" id="mwASo">]</span></span></a></sup> وبحسب <a rel="mw:WikiLink" href="./المسعودي" title="المسعودي" id="mwASs">المسعودي</a>، الذي كتب في القرن العاشر، كان العِباد جميعًا نساطرة، أي أعضاء في كنيسة المشرق.<sup about="#mwt124" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201015–16_20-2" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201015–16"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201015–16-20"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"pp":{"wt":"15–16"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201015–16-20" id="mwASw"><span class="mw-reflink-text" id="mwAS0"><span class="cite-bracket" id="mwAS4">[</span>20<span class="cite-bracket" id="mwAS8">]</span></span></a></sup></p>

<p id="mwATA">وفي عام 636، أثناء <a rel="mw:WikiLink" href="./الفتح_الإسلامي_لفارس" title="الفتح الإسلامي لفارس" id="mwATE">الفتح الإسلامي لفارس</a>، هُدمت كنيسة الحيرة لكي يتمكن <a rel="mw:WikiLink" href="./سعد_بن_أبي_وقاص" title="سعد بن أبي وقاص" id="mwATI">سعد بن أبي وقاص</a> من بناء عاصمته في الكوفة.<sup about="#mwt127" class="mw-ref reference" id="cite_ref-FOOTNOTETrimingham1979171_12-3" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTETrimingham1979171"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETrimingham1979171-12"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Trimingham"},"2":{"wt":"1979"},"p":{"wt":"171"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTETrimingham1979171-12" id="mwATM"><span class="mw-reflink-text" id="mwATQ"><span class="cite-bracket" id="mwATU">[</span>12<span class="cite-bracket" id="mwATY">]</span></span></a></sup> وفي الكتابات الإسلامية اللاحقة، أصبحت الحيرة رمزًا لزوال منجزات الدنيا. وكانت موضعًا شائعًا لمجالس اللهو والشراب في <a rel="mw:WikiLink" href="./خمريات" title="خمريات" id="mwATc">الخَمريّات</a>، أي شعر الخمر، عند «الشعراء الماجنين» أو شعراء المجون في الكوفة، لأن أديرة الحيرة ارتبطت بالشرب والحانات.<sup about="#mwt130" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201018_23-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201018"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201018-23"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"18"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201018-23" id="mwATg"><span class="mw-reflink-text" id="mwATk"><span class="cite-bracket" id="mwATo">[</span>23<span class="cite-bracket" id="mwATs">]</span></span></a></sup> وبحسب <a rel="mw:WikiLink" href="./الشابشتي" title="الشابشتي" id="mwATw">الشابشتي</a>، فإن ابنة النعمان الثالث، <a rel="mw:WikiLink" href="./الحرقة" title="الحرقة" id="mwAT0">هند بنت النعمان</a>، التي اعتزلت في دير، التقت سعد بن أبي وقاص <a rel="mw:WikiLink" href="./المغيرة_بن_شعبة_الثقفي" title="المغيرة بن شعبة الثقفي" class="mw-redirect" id="mwAT4">والمغيرة بن شعبة الثقفي</a> في نحو زمن الفتح، وقالت لهما:</p>

<blockquote id="mwAT8">
<p id="mwAUA">في المساء، لم يكن على الأرض عربي إلا يطلب منا العطاء ويمجدنا، ثم أصبحنا في الصباح لا نجد أحدًا إلا نطلب منه العطاء ونمجده!<sup about="#mwt133" class="mw-ref reference" id="cite_ref-FOOTNOTEToral-Niehoff201018_23-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"FOOTNOTEToral-Niehoff201018"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEToral-Niehoff201018-23"},"parts":[{"template":{"target":{"wt":"sfn","href":"./قالب:Sfn"},"params":{"1":{"wt":"Toral-Niehoff"},"2":{"wt":"2010"},"p":{"wt":"18"}},"i":0}}]}'><a href="./العباد#cite_note-FOOTNOTEToral-Niehoff201018-23" id="mwAUE"><span class="mw-reflink-text" id="mwAUI"><span class="cite-bracket" id="mwAUM">[</span>23<span class="cite-bracket" id="mwAUQ">]</span></span></a></sup></p>
</blockquote>

