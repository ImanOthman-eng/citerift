s of neurons that synthesize dopamine</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox anatomy\n","href":"./Template:Infobox_anatomy"},"params":{"Name":{"wt":"Dopaminergic cell groups"},"Latin":{"wt":"cellulae dopaminergicae"}},"i":0}}]}' id="mwAw"><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style></span><table class="infobox" about="#mwt2" id="mwBA"><tbody><tr><th colspan="2" class="infobox-above" style="background-color:dimgray; color: white">Dopaminergic cell groups</th></tr><tr><th colspan="2" class="infobox-header" style="background-color: #efefef;color:inherit;">Details</th></tr><tr><th colspan="2" class="infobox-header" style="background-color: #efefef;color:inherit;">Identifiers</th></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.25em"><a rel="mw:WikiLink" href="./Latin" title="Latin">Latin</a></th><td class="infobox-data"><i>cellulae dopaminergicae</i></td></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.25em"><a rel="mw:WikiLink" href="./Medical_Subject_Headings" title="Medical Subject Headings">MeSH</a></th><td class="infobox-data"><a rel="mw:ExtLink nofollow" href="https://meshb.nlm.nih.gov/record/ui?ui=D059290" class="external text">D059290</a></td></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.25em"><a rel="mw:WikiLink" href="./NeuroNames" title="NeuroNames">NeuroNames</a></th><td class="infobox-data"><a rel="mw:ExtLink nofollow" href="http://braininfo.rprc.washington.edu/centraldirectory.aspx?ID=3138" class="external text">3138</a></td></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.25em"><a rel="mw:WikiLink" href="./Terminologia_Anatomica" title="Terminologia Anatomica">TA98</a></th><td class="infobox-data"><a rel="mw:ExtLink nofollow" href="https://ifaa.unifr.ch/Public/EntryPage/TA98%20Tree/Entity%20TA98%20EN/14.1.09.611%20Entity%20TA98%20EN.htm" class="external text">A14.1.09.611</a></td></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.25em"><a rel="mw:WikiLink" href="./Foundational_Model_of_Anatomy" title="Foundational Model of Anatomy">FMA</a></th><td class="infobox-data"><a rel="mw:ExtLink nofollow" href="https://bioportal.bioontology.org/ontologies/FMA/?p=classes&amp;conceptid=http%3A%2F%2Fpurl.org%2Fsig%2Font%2Ffma%2Ffma78545" class="external text">78545</a></td></tr><tr><td colspan="2" class="infobox-below"><a rel="mw:WikiLink" href="./Anatomical_terminology" title="Anatomical terminology">Anatomical terminology</a><div style="text-align: right;"><small class="noprint"><span typeof="mw:Entity">[</span><a rel="mw:WikiLink/Interwiki" href="https://www.wikidata.org/wiki/Q5297290" title="d:Q5297290" class="extiw">edit on Wikidata</a>]</small></div></td></tr></tbody></table>
<p id="mwBQ"><b id="mwBg">Dopaminergic cell groups</b>, <b id="mwBw">DA cell groups</b>, or <b id="mwCA">dopaminergic nuclei</b> are collections of <a rel="mw:WikiLink" href="./Neuron" title="Neuron" id="mwCQ">neurons</a> in the <a rel="mw:WikiLink" href="./Central_nervous_system" title="Central nervous system" id="mwCg">central nervous system</a> that synthesize the <a rel="mw:WikiLink" href="./Neurotransmitter" title="Neurotransmitter" id="mwCw">neurotransmitter</a> <a rel="mw:WikiLink" href="./Dopamine" title="Dopamine" id="mwDA">dopamine</a>.<sup about="#mwt9" class="mw-ref reference" id="cite_ref-braininfo_1-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"braininfo"},"body":{"id":"mw-reference-text-cite_note-braininfo-1"}}'><a href="./Dopaminergic_cell_groups#cite_note-braininfo-1" id="mwDQ"><span class="mw-reflink-text" id="mwDg"><span class="cite-bracket" id="mwDw">[</span>1<span class="cite-bracket" id="mwEA">]</span></span></a></sup> In the 1960s, <a rel="mw:WikiLink" href="./Dopaminergic_pathways" title="Dopaminergic pathways" id="mwEQ">dopaminergic neurons</a> or <i id="mwEg">dopamine neurons</i>  were first identified and named by <a rel="mw:WikiLink" href="./Annica_Dahlström" title="Annica Dahlström" id="mwEw">Annica Dahlström</a> and <a rel="mw:WikiLink/Interwiki" href="https://sv.wikipedia.org/wiki/Kjell%20Fuxe" title="sv:Kjell Fuxe" class="extiw" id="mwFA">Kjell Fuxe</a>, who used <a rel="mw:WikiLink" href="./Histochemical_tracer" title="Histochemical tracer" id="mwFQ">histochemical</a> <a rel="mw:WikiLink" href="./Fluorescence" title="Fluorescence" id="mwFg">fluorescence</a>.<sup about="#mwt4" class="mw-ref reference" id="cite_ref-FOOTNOTEFuxeHoekfeltUngerstedt1970_2-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEFuxeHoekfeltUngerstedt1970"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEFuxeHoekfeltUngerstedt1970-2"},"parts":[{"template":{"target":{"wt":"sfnp","href":"./Template:Sfnp"},"params":{"1":{"wt":"Fuxe"},"2":{"wt":"Hoekfelt"},"3":{"wt":"Ungerstedt"},"4":{"wt":"1970"}},"i":0}}]}'><a href="./Dopaminergic_cell_groups#cite_note-FOOTNOTEFuxeHoekfeltUngerstedt1970-2" id="mwFw"><span class="mw-reflink-text" id="mwGA"><span class="cite-bracket" id="mwGQ">[</span>2<span class="cite-bracket" id="mwGg">]</span></span></a></sup> The subsequent discovery of genes encoding enzymes that synthesize dopamine, and transporters that incorporate dopamine into synaptic vesicles or reclaim it after synaptic release, enabled scientists to identify dopaminergic neurons by labeling gene or protein expression that is specific to these neurons.</p>

<p id="mwGw">In the mammalian brain, dopaminergic neurons form a semi-continuous population extending from the midbrain through the forebrain, with eleven named collections or clusters among them.<sup about="#mwt10" class="mw-ref reference" id="cite_ref-FOOTNOTESmeetsReiner1994_3-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTESmeetsReiner1994"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTESmeetsReiner1994-3"},"parts":[{"template":{"target":{"wt":"sfnp","href":"./Template:Sfnp"},"params":{"1":{"wt":"Smeets"},"2":{"wt":"Reiner"},"3":{"wt":"1994"}},"i":0}}]}'><a href="./Dopaminergic_cell_groups#cite_note-FOOTNOTESmeetsReiner1994-3" id="mwHA"><span class="mw-reflink-text" id="mwHQ"><span class="cite-bracket" id="mwHg">[</span>3<span class="cite-bracket" id="mwHw">]</span></span></a></sup><sup about="#mwt13" class="mw-ref reference" id="cite_ref-FOOTNOTEFeltenSladek_Jr1983_4-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEFeltenSladek Jr1983"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEFeltenSladek_Jr1983-4"},"parts":[{"template":{"target":{"wt":"sfnp","href":"./Template:Sfnp"},"params":{"1":{"wt":"Felten"},"2":{"wt":"Sladek Jr"},"3":{"wt":"1983"}},"i":0}}]}'><a href="./Dopaminergic_cell_groups#cite_note-FOOTNOTEFeltenSladek_Jr1983-4" id="mwIA"><span class="mw-reflink-text" id="mwIQ"><span class="cite-bracket" id="mwIg">[</span>4<span class="cite-bracket" id="mwIw">]</span></span></a></sup><sup about="#mwt16" class="mw-ref reference" id="cite_ref-FOOTNOTEDubach1994_5-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEDubach1994"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEDubach1994-5"},"parts":[{"template":{"target":{"wt":"sfnp","href":"./Template:Sfnp"},"params":{"1":{"wt":"Dubach"},"2":{"wt":"1994"}},"i":0}}]}'><a href="./Dopaminergic_cell_groups#cite_note-FOOTNOTEDubach1994-5" id="mwJA"><span class="mw-reflink-text" id="mwJQ"><span class="cite-bracket" id="mwJg">[</span>5<span class="cite-bracket" id="mwJw">]</span></span></a></sup></p>
