  "cp": 10376,
  "cp_end": 10488,
  "def_kind": "generated_note",
  "label": {
   "templates": [],
   "unstructured": false
  },
  "body": "The sources do not define the exact basis for the king imposing this fine.<ref name=Saunders101/><ref name=DNB/>"
 },
