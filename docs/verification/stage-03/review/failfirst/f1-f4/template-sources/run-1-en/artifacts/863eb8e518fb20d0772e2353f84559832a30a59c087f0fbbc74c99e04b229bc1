teText, '<>\"') ..\n\t\t\t'\" class=\"tooltip tooltip-dashed\" style=\"border-bottom: 1px dashed;')\n\tend\n\t\n\t-- close tooltip span\n\tout('\">')\n\t\n\t-- prefix, if not inserted above\n\tif (isblank(params.quote)) and notblank(params.prefix) then\n\t\tout(params.prefix)\n\tend\n\t\n\t--pp and sup-where\n\tout(params.pp or '')\n\tout(params['sup-where'] or '')\n\t\n\t-- suffix\n\tif notblank(params.quote) then\n\t\tout(\"</span>\" .. (params.suffix or \"\"))\n\telse\n\t\tout((params.suffix or \"\") .. \"</span>\")\n\tend\n\n\tout(\"</sup>\")\n\n\treturn table.concat(out)\nend\nfunction r.superscript(frame)\n\treturn r._superscript(getArgs(frame))\nend\n\n-- Implements [[Template:R/details]] formatting for the details= field\n-- Only for template/module use: |where=value |quote-where=value |quote=value |language=value |translation=value |annotation=value |contentId=value |qcli = firstArg(params, 'quote-cite', 'link-id')\nfunction r._details(params)\n\tif not params or (\n\t\t\tisblank(params[\"where\"]) and\n\t\t\tisblank(params[\"quote-where\"]) and\n\t\t\tisblank(params[\"quote\"]) and\n\t\t\tisblank(params[\"annotation\"])\n\t) then\n\t\treturn \"\"\n\tend\n\n\tlocal out = setmetatable({}, mt)\n\n\t-- process language\n\tlocal langText = \"\"\n\tlocal langName = \"\"\n\tif notblank(params.language) then\n\t\tlangName = lang._is_ietf_tag(params.language) and lang._name_from_tag{params.language} or params.language\n\t\tlangText = \"&#32;(in \" .. langName .. \")\"\n\tend\n\n\t-- process location\n\tlocal whereText = isblank(params[\"where\"]) and (params[\"quote-where\"] or \"\")\n\t\tor (params[\"where\"] or \"\")\n\tif isblank(params.annotation) and isblank(params.quote) and notblank(whereText) then\n\t\tout(whereText)\n\tend\n\n\tlocal stripError=false\n\n\t-- Annotation block if present\n\tlocal annotation = mw.text.killMarkers(params.annotation or '')\n\tif notblank(annotation) then\n\t\tif annotation ~= params.annotation then stripError=true end\n\t\tannotation = mw.ustring.gsub(mw.text.trim(annotation), \"^:\", \"\")\n\t\tif notblank(whereText) then\n\t\t\tannotation = mw.ustring.gsub(annotation, \"^\" .. mw.text.decode(whereText) .. \": *\", \"\")\n\t\t\tout(whereText .. (isblank(params.quote) and langText or \"\") .. \"&#58;&#32;\")\n\t\tend\n\t\tout(annotation)\n\t\tif mw.ustring.sub(annotation, -1) ~= \".\" then\n\t\t\tout(\".\")\n\t\tend\n\t\tout(\"&#32;\")\n\tend\n\t\n\t-- Quotation block if present\n\tlocal quote = mw.text.killMarkers(trim_quotes(params.quote or ''))\n\tif notblank(quote) then\n\t\tif quote ~= trim_quotes(params.quote or '') then stripError = true end\n\t\tif notblank(params[\"quote-where\"]) then\n\t\t\tif params[\"quote-where\"] ~= whereText or isblank(annotation) then\n\t\t\t\tif params[\"quote-where\"] ~= whereText and isblank(annotation) then\n\t\t\t\t\tout(whereText .. \".&#32;\")\n\t\t\t\tend\n\t\t\t\tout(params[\"quote-where\"] .. langText .. \"&#58;&#32;\")\n\t\t\telseif notblank(langName) then\n\t\t\t\tout(\"In \" .. langName .. \"&#58;&#32;\")\n\t\t\tend\n\t\telseif isblank(annotation) and notblank(whereText) then\n\t\t\tout(whereText .. langText .. \"&#58;&#32;\")\n\t\telseif notblank(whereText) and table.concat(out) == whereText then\n\t\t\tout(langText .. \"&#58;&#32;\")\n\t\telseif notblank(langName) then\n\t\t\tout(\"In \" .. langName .. \"&#58;&#32;\")\n\t\tend\n\n\t\tout(make_quote(params, params.contentId, params.qcli, quote))\n\telseif table.concat(out) == whereText then\n\t\tout(langText .. \".&#32;\")\n\tend\n\n\tif stripError == true then\n\t\tlocal errorMsg = ' Nested references and other parser functions that produce [[:mw:Strip_marker|strip markers]] are not supported in quotes or annotations when using sub-referencing.'\n\t\tmw.addWarning('<span style=\"color:#d33\">Error in citation using {{tl|R}}:</span>' .. errorMsg)\n\t\tout('<span class=\"cs1-visible-error citation-comment template-r-error\">' .. errorMsg .. '</span>')\n\tend\n\n\treturn table.concat(out)\nend\nfunction r.details(frame)\n\treturn r._details(getArgs(frame))\nend\n\n-- Implements [[Template:R/ref]]\nfunction r._ref(params, frame)\n\tframe = frame or mw.getCurrentFrame()\n\tlocal out = setmetatable({}, mt)\n\t\n\tlocal contextSectionName = mw.uri.anchorEncode(\n\t\t\t'cite_sect-' ..\n\t\t\ttrim_quotes(params[1] or '') ..\t'-' ..\n\t\t\ttrim_quotes(params[2] or '') .. '-' .. \n\t\t\ttrim_quotes(\n\t\t\t\t(notblank(params.page) and params.page or hyphen2dash(params.pages or '', ' ')) ..\n\t\t\t\t(params.location or '')\n\t\t\t)\n\t\t)\n\tlocal contentId = notblank(params['content-id']) and mw.uri.anchorEncode(params['content-id']) or nil\n\tlocal whereArgs = {\n\t\tplural = hyphen2dash(params.pages, ' '),\n\t\tsingular = params.page,\n\t\tlocation = params.location,\n\t\tspacing = '&#32;'\n\t}\n\tlocal quoteWhereArgs = {\n\t\tplural = hyphen2dash(params['quote-pages'], ' '),\n\t\tsingular = params['quote-page'],\n\t\tlocation = params['quote-location'],\n\t\tspacing = '&#32;'\n\t}\n\tlocal refArgs = {name = params[1] or '', group = params[2] or ''}\n\n\tlocal leadin = params.leadin or ''\n\tlocal quote = trim_quotes(params.quote or '')\n\tlocal quotePage = firstArg(params, 'quote-pages', 'quote-page', 'quote-location')\n\tlocal qcli = firstArg(params, 'quote-cite', 'link-id')\n\n\t-- Whether or not to use subreferencing. Set to default for now, but this should changed when moved to enwiki\n\tlocal subreferencing = ({sub = 1, subreference = 1, ['sub-reference']=1})[string.ulower(params.style or '')] == 1\n\t\n\t-- Debug facility\n\tif notblank(params.debug) then\n\t\tout(\"DEBUG: \")\n\t\tfor k, v in pairs(params) do\n\t\t\tout(k .. \"=\" .. (v or '') .. \", \")\n\t\tend\n\t\tout(\". Potential context-section-name:\")\n\t\tout(contextSectionName .. '\".')\n\tend\n\t\n\t-- Opening \"support context\" span\n\tlocal lst\n\tif notblank(params.section) then\n\t\tlocal section = (params.section == 'yes' or params.section == 'y') and\n\t\t\tcontextSectionName or para