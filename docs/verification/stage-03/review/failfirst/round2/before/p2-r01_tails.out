control (plain text after cite): state='recognized_warning_text' evidence=[('warning', 'Retracted')]
text after an HTML comment     : state='no_recognized_warning_in_inspected_region' evidence=[]
text after <link> (category)   : state='no_recognized_warning_in_inspected_region' evidence=[]
text after <style>             : state='no_recognized_warning_in_inspected_region' evidence=[]
text after <meta>              : state='no_recognized_warning_in_inspected_region' evidence=[]
text after backlink span       : state='no_recognized_warning_in_inspected_region' evidence=[]
