-- _find evidence offsets after casefold expansion (pure function) --
'Straße. Retracted' -> [('retracted', 'Retracted')]
'İİİ İstanbul retracted here' -> [('retracted', 'retracted')]
'ﬁﬂ Retracted' -> [('retracted', 'Retracted')]
-- through the public API --
unstructured ref with ß/İ: state='recognized_warning_text' evidence=[('warning', 'Retracted')]
