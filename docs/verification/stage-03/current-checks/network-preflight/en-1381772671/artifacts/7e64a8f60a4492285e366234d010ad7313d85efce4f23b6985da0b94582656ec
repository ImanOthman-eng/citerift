<tr id="mwAls">
<td id="mwAlw"><a rel="mw:WikiLink" href="./Mumps" title="Mumps" id="mwAl0">Mumps</a></td>
<td id="mwAl4"><a rel="mw:WikiLink" href="./Mumpsvax" title="Mumpsvax" class="mw-redirect" id="mwAl8">Mumpsvax</a><sup about="#mwt292" class="mw-ref reference" id="cite_ref-Merck_Mumpsvax_1999_pdf_71-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Merck_Mumpsvax_1999_pdf"},"body":{"id":"mw-reference-text-cite_note-Merck_Mumpsvax_1999_pdf-71"}}'><a href="./MMR_vaccine#cite_note-Merck_Mumpsvax_1999_pdf-71" id="mwAmA"><span class="mw-reflink-text" id="mwAmE"><span class="cite-bracket" id="mwAmI">[</span>71<span class="cite-bracket" id="mwAmM">]</span></span></a></sup></td>
<td id="mwAmQ"><a rel="mw:WikiLink" href="./Jeryl_Lynn" title="Jeryl Lynn" id="mwAmU">Jeryl Lynn</a> (B level) strain<sup about="#mwt295" class="mw-ref reference" id="cite_ref-Jeryl_Lynn_1967_pdf_72-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Jeryl_Lynn_1967_pdf"},"body":{"id":"mw-reference-text-cite_note-Jeryl_Lynn_1967_pdf-72"}}'><a href="./MMR_vaccine#cite_note-Jeryl_Lynn_1967_pdf-72" id="mwAmY"><span class="mw-reflink-text" id="mwAmc"><span class="cite-bracket" id="mwAmg">[</span>72<span class="cite-bracket" id="mwAmk">]</span></span></a></sup></td></tr>
<tr id="mwAmo">
<td id="mwAms"><a rel="mw:WikiLink" href="./Rubella" title="Rubella" id="mwAmw">Rubella</a></td>
