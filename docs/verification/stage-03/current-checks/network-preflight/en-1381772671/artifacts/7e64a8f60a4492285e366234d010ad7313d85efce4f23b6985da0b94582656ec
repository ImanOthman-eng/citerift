<td id="mwAlQ">Enders' attenuated Edmonston strain<sup about="#mwt289" class="mw-ref reference" id="cite_ref-70" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-70"}}'><a href="./MMR_vaccine#cite_note-70" id="mwAlU"><span class="mw-reflink-text" id="mwAlY"><span class="cite-bracket" id="mwAlc">[</span>70<span class="cite-bracket" id="mwAlg">]</span></span></a></sup></td>
