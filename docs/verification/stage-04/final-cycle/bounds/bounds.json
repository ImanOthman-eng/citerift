    "Stage 03 extraction (byte-for-byte, no wrapper)": {
      "bound_bytes": 268435456,
      "why": "Stage 03 refuses a worker output over MAX_OUTPUT_BYTES; the worker writes canonical_bytes, the same encoding as Stage 04 canon (sort_keys, compact separators, UTF-8, no ASCII escaping), so the blob is the worker's output byte for byte. Equal to the limit: no headroom, never over it.",
      "within_limit": true,
      "fraction_of_limit": 1.0
    },
    "ACQUIRE observation (bundle)": {
      "bound_bytes": 125894656,
      "why": "Conditional on the Step 8 representation: the capture document plus at most the bundle's source (<= 4 MiB) and render (<= 16 MiB), each embedded as a JSON string (<= 6 bytes per input byte). The capture document is not bounded by its schema (attempts, issues, failure_artifacts have no maxItems); measured 3,796 to 5,235 bytes on retained bundles; 64 KiB is allowed. Over the limit is BLOB_TOO_LARGE, a STORAGE_ERROR (fail closed). Step 8 design condition.",
      "within_limit": true,
      "fraction_of_limit": 0.469
    },
