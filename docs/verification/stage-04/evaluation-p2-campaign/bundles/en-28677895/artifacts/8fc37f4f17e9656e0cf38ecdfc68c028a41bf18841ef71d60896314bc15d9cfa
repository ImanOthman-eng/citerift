dentifier)" title="Doi (identifier)" class="mw-redirect" id="mwDB4">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1002%2Fda.21964" class="external text" id="mwDB8">10.1002/da.21964</a>. <a rel="mw:WikiLink" href="./PMC_(identifier)" title="PMC (identifier)" class="mw-redirect" id="mwDCA">PMC</a><span typeof="mw:Entity" id="mwDCE"> </span><span class="id-lock-free" title="Freely accessible" id="mwDCI"><a rel="mw:ExtLink nofollow" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3718554" class="external text" id="mwDCM">3718554</a></span>. <a rel="mw:WikiLink" href="./PMID_(identifier)" title="PMID (identifier)" class="mw-redirect" id="mwDCQ">PMID</a><span typeof="mw:Entity" id="mwDCU"> </span><a rel="mw:ExtLink nofollow" href="https://pubmed.ncbi.nlm.nih.gov/22700446" class="external text" id="mwDCY">22700446</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Depression+and+Anxiety&amp;rft.atitle=Meditative+Therapies+for+Reducing+Anxiety%3A+A+Systematic+Review+and+Meta-Analysis+of+Randomized+Controlled+Trials&amp;rft.volume=29&amp;rft.issue=7&amp;rft.pages=1%2C+11-12&amp;rft.date=2012-06&amp;rft_id=https%3A%2F%2Fwww.ncbi.nlm.nih.gov%2Fpmc%2Farticles%2FPMC3718554%23id-name%3DPMC&amp;rft_id=info%3Apmid%2F22700446&amp;rft_id=info%3Adoi%2F10.1002%2Fda.21964&amp;rft.aulast=Chen&amp;rft.aufirst=Kevin+W.&amp;rft.au=Christine+C.+Berger&amp;rft.au=Eric+Manheimer&amp;rft.au=Darlene+Forde&amp;rft.au=Jessica+Magidson&amp;rft.au=Laya+Dachman&amp;rft.au=C.+W.+Lejuez&amp;rft_id=https%3A%2F%2Fwww.ncbi.nlm.nih.gov%2Fpmc%2Farticles%2FPMC3718554&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATranscendental+Meditation+technique" class="Z3988" about="#mwt433" id="mwDCc"></span></span></li>
<li about="#cite_note-Integrative_Cardiology-122" id="cite_note-Integrative_Cardiology-122" data-mw-footnote-number="122"><span class="mw-cite-backlink" id="mwDCg"><a href="./Transcendental_Meditation_technique#cite_ref-Integrative_Cardiology_122-0" rel="mw:referencedBy" id="mwDCk"><span class="mw-linkback-text" id="mwDCo">↑</span></a></span> <span id="mw-reference-text-cite_note-Integrative_Cardiology-122" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt436" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"author":{"wt":"James Dalen"},"editor":{"wt":"Stephen Devries"},"title":{"wt":"Integrative Cardiology"},"year":{"wt":"2011"},"publisher":{"wt":"Oxford University Press"},"location":{"wt":"New York"},"isbn":{"wt":"978-0-19-538346-1"},"pages":{"wt":"236, 237"},"chapter":{"wt":"The Integrative Approach to Hypertension, Ch. 11"},"quote":{"wt":"A 2008 meta-analysis of nine studies found a 4.7 mmHg systolic blood pressure and 3.2 mmHg diastolic blood pressure decrease in those who practiced TM compared to control groups that included health education. These decreases were judged to be clinically significant."}},"i":0}}]}' id="mwDCs"/><cite id="mwDCw" class="citation book cs1" about="#mwt436" data-x-id="CITEREFJames_Dalen2011">James Dalen (2011). "The Integrative Approach to Hypertension, Ch. 11". In Stephen Devries (ed.). <i id="mwDC0">Integrative Cardiology</i>. New York: Oxford University Press. pp.<span typeof="mw:Entity" id="mwDC4"> </span>236, 237. <a rel="mw:WikiLink" href="./ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwDC8">ISBN</a><span typeof="mw:Entity" id="mwDDA"> </span><a rel="mw:WikiLink" href="./Special:BookSources/978-0-19-538346-1" title="Special:BookSources/978-0-19-538346-1" id="mwDDE"><bdi id="mwDDI">978-0-19-538346-1</bdi></a>. <q id="mwDDM">A 2008 meta-analysis of nine studies found a 4.7 mmHg systolic blood pressure and 3.2 mmHg diastolic blood pressure decrease in those who practiced TM compared to control groups that included health education. These decreases were judged to be clinically significant.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=The+Integrative+Approach+to+Hypertension%2C+Ch.+11&amp;rft.btitle=Integrative+Cardiology&amp;rft.place=New+York&amp;rft.pages=236%2C+237&amp;rft.pub=Oxford+University+Press&amp;rft.date=2011&amp;rft.isbn=978-0-19-538346-1&amp;rft.au=James+Dalen&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATranscendental+Meditation+technique" class="Z3988" about="#mwt436" id="mwDDQ"></span></span></li>
<li about="#cite_note-123" id="cite_note-123" data-mw-footnote-number="123"><span class="mw-cite-backlink" id="mwDDU"><a href="./Transcendental_Meditation_technique#cite_ref-123" rel="mw:referencedBy" id="mwDDY"><span class="mw-linkback-text" id="mwDDc">↑</span></a></span> <span id="mw-reference-text-cite_note-123" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt441" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"author":{"wt":"Krisanaprakornkit T, Ngamjarus C, Witoonchart C, Piyavhatkul N"},"title":{"wt":"Meditation therapies for attention-deficit/hyperactivity disorder (ADHD)"},"journal":{"wt":"Cochrane Database Syst Rev"},"volume":{"wt":"2010"},"issue":{"wt":"6"},"article-number":{"wt":"CD006507"},"year":{"wt":"2010"},"pmid":{"wt":"20556767"},"pmc":{"wt":"6823216"},"doi":{"wt":"10.1002/14651858.CD006507.pub2"},"quote":{"wt":"As a result of the limited number of included studies, the small sample sizes and the high risk of bias"},"editor1-last":{"wt":"Krisanaprakornkit"},"editor1-first":{"wt":"Thawatchai"}},"i":0}}]}' id="mwDDg"/><cite id="CITEREFKrisanaprakornkit_T,_Ngamjarus_C,_Witoonchart_C,_Piyavhatkul_N2010" class="citation journal cs1" about="#mwt441">Krisanaprakornkit T, Ngamjarus C, Witoonchart C, Piyavhatkul N (2010). Krisanaprakornkit, Thawatchai (ed.). <a rel="mw:ExtLink nofollow" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6823216" class="external text" id="mwDDk">"Meditation therapies for attention-deficit/hyperactivity disorder (ADHD)"</a>. <i id="mwDDo">Cochrane Database Syst Rev</i>. <b id="mwDDs">2010</b> (6) CD006507. <a rel="mw:WikiLink" href="./Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwDDw">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1002%2F14651858.CD006507.pub2" class="external text" id="mwDD0">10.1002/14651858.CD006507.pub2</a>. <a rel="mw:WikiLink" href="./PMC_(identifier)" title="PMC (identifier)" class="mw-redirect" id="mwDD4">PMC</a><span typeof="mw:Entity" id="mwDD8"> </span><span class="id-lock-free" title="Freely accessible" id="mwDEA"><a rel="mw:ExtLink nofollow" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6823216" class="external text" id="mwDEE">6823216</a></span>. <a rel="mw:WikiLink" href="./PMID_(identifier)" title="PMID (identifier)" class="mw-redirect" id="mwDEI">PMID</a><span typeof="mw:Entity" id="mwDEM"> </span><a rel="mw:ExtLink nofollow" href="https://pubmed.ncbi.nlm.nih.gov/20556767" class="external text" id="mwDEQ">20556767</a>. <q id="mwDEU">As a result of the limited number of included studies, the small sample sizes and the high risk of bias</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Cochrane+Database+Syst+Rev&amp;rft.atitle=Meditation+therapies+for+attention-deficit%2Fhyperactivity+disorder+%28ADHD%29&amp;rft.volume=2010&amp;rft.issue=6&amp;rft.artnum=CD006507&amp;rft.date=2010&amp;rft_id=https%3A%2F%2Fwww.ncbi.nlm.nih.gov%2Fpmc%2Farticles%2FPMC6823216%23id-name%3DPMC&amp;rft_id=info%3Apmid%2F20556767&amp;rft_id=info%3Adoi%2F10.1002%2F14651858.CD006507.pub2&amp;rft.au=Krisanaprakornkit+T%2C+Ngamjarus+C%2C+Witoonchart+C%2C+Piyavhatkul+N&amp;rft_id=https%3A%2F%2Fwww.ncbi.nlm.nih.gov%2Fpmc%2Farticles%2FPMC6823216&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATranscendental+Meditation+technique" class="Z3988" about="#mwt441" id="mwDEY"></span><span class="cs1-maint citation-comment" about="#mwt441" id="mwDEc"><code class="cs1-code" id="mwDEg">{{<a rel="mw:WikiLink" href="./Template:Cite_journal" title="Template:Cite journal" id="mwDEk">cite journal</a>}}</code>:  CS1 maint: multiple names: authors list (<a rel="mw:WikiLink" href="./Category:CS1_maint:_multiple_names:_authors_list" title="Category:CS1 maint: multiple names: authors list" id="mwDEo">link</a>)</span><link rel="mw:PageProp/Category" href="./Category:CS1_maint:_multiple_names:_authors_list" about="#mwt441" id="mwDEs"/></span></li>
<li about="#cite_note-124" id="cite_note-124" data-mw-footnote-number="124"><span class="mw-cite-backlink" id="mwDEw"><a href="./Transcendental_Meditation_technique#cite_ref-124" rel="mw:referencedBy" id="mwDE0"><span class="mw-linkback-text" id="mwDE4">↑</span></a></span> <span id="mw-reference-text-cite_note-124" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt445" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"first":{"wt":"Peter"},"last":{"wt":"Sedlmeier"},"author2":{"wt":"Eberth, Juliane"},"date":{"wt":"May 2012"},"title":{"wt":"The Psychological Effects of Meditation: A Meta-Analysis"},"quote":{"wt":". . . notwithstanding the not so positive conclusion of Ospina et al., the claim of therapeutic benefits of meditation is backed up by growing empirical evidence."},"journal":{"wt":"Psychological Bulletin"},"doi":{"wt":"10.1037/a0028168"},"pmid":{"wt":"22582738"},"display-authors":{"wt":"etal"},"volume":{"wt":"138"},"issue":{"wt":"6"},"pages":{"wt":"1139–1171"}},"i":0}}]}' id="mwDE8"/><cite id="CITEREFSedlmeierEberth,_Juliane2012" class="citation journal cs1" about="#mwt445">Sedlmeier, Peter; Eberth, Juliane; et<span typeof="mw:Entity" id="mwDFA"> </span>al. (May 2012). "The Psychological Effects of Meditation: A Meta-Analysis". <i id="mwDFE">Psychological Bulletin</i>. <b id="mwDFI">138</b> (6): <span class="nowrap" id="mwDFM">1139–</span>1171. <a rel="mw:WikiLink" href="./Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwDFQ">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1037%2Fa0028168" class="external text" id="mwDFU">10.1037/a0028168</a>. <a rel="mw:WikiLink" href="./PMID_(identifier)" title="PMID (identifier)" class="mw-redirect" id="mwDFY">PMID</a><span typeof="mw:Entity" id="mwDFc"> </span><a rel="mw:ExtLink nofollow" href="https://pubmed.ncbi.nlm.nih.gov/22582738" class="external text" id="mwDFg">22582738</a>. <q id="mwDFk">. . . notwithstanding the not so positive conclusion of Ospina et al., the claim of therapeutic benefits of meditation is backed up by growing empirical evidence.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Psychological+Bulletin&amp;rft.atitle=The+Psychological+Effects+of+Meditation%3A+A+Meta-Analysis&amp;rft.volume=138&amp;rft.issue=6&amp;rft.pages=1139-1171&amp;rft.date=2012-05&amp;rft_id=info%3Adoi%2F10.1037%2Fa0028168&amp;rft_id=info%3Apmid%2F22582738&amp;rft.aulast=Sedlmeier&amp;rft.aufirst=Peter&amp;rft.au=Eberth%2C+Juliane&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATranscendental+Meditation+technique" class="Z3988" about="#mwt445" id="mwDFo"></span></span></li>
<li about="#cite_note-125" id="cite_note-125" data-mw-footnote-number="125"><span class="mw-cite-backlink" id="mwDFs"><a href="./Transcendental_Meditation_technique#cite_ref-125" rel="mw:referencedBy" id="mwDFw"><span class="mw-linkback-text" id="mwDF0">↑</span></a></span> <span id="mw-reference-text-cite_note-125" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt448" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"first":{"wt":"Kevin W."},"last":{"wt":"Chen"},"author2":{"wt":"Christine C. Berger"},"date":{"wt":"June 2012"},"title":{"wt":"Meditative Therapies for Reducing Anxiety: A Systematic Review and Meta-Analysis of Randomized Controlled Trials"},"quote":{"wt":"(referring to studies included in their review) \"The general quality of these RCTs were acceptable as per CLEAR-NPT: sixteen (40%) studies had a quality score of 0.8 or better, indicating a good quality in research design (p. 5) . . . . the majority of existing reviews have applied evaluation criteria based on pharmaceutical RCT&apos;s that tended to underestimate the actual quality of these studies, since many of the traditional criteria for quality assessment may not apply to the study of meditative therapies (p. 3) . . . . the overall quality of meditation studies have increased continuously in the past 10 years. Our analysis of study quality over time indicates that studies published prior to 2000 had a relatively lower quality score (CLEAR=.66), studies published in 2000-2005 had a slightly higher score (CLEAR=.69), whereas studies published after 2006 has a mean quality score of .75 (p. 13)"},"journal":{"wt":"Depression and Anxiety"},"volume":{"wt":"29"},"issue":{"wt":"7"},"pages":{"wt":"545–562"},"doi":{"wt":"10.1002/da.21964"},"pmid":{"wt":"22700446"},"display-authors":{"wt":"etal"},"pmc":{"wt":"3718554"}},"i":0}}]}' id="mwDF4"/><cite id="CITEREFChenChristine_C._Berger2012" class="citation journal cs1" about="#mwt448">Chen, Kevin W.; Christine C. Berger; et<span typeof="mw:Entity" id="mwDF8"> </span>al. (June 2012). <a rel="mw:ExtLink nofollow" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3718554" class="external text" id="mwDGA">"Meditative Therapies for Reducing Anxiety: A Systematic Review and Meta-Analysis of Randomized Controlled Trials"</a>. <i id="mwDGE">Depression and Anxiety</i>. <b id="mwDGI">29</b> (7): <span class="nowrap" id="mwDGM">545–</span>562. <a rel="mw:WikiLink" href="./Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwDGQ">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1002%2Fda.21964" class="external text" id="mwDGU">10.1002/da.21964</a>. <a rel="mw:WikiLink" href="./PMC_(identifier)" title="PMC (identifier)" class="mw-redirect" id="mwDGY">PMC</a><span typeof="mw:Entity" id="mwDGc"> </span><span class="id-lock-free" title="Freely accessible" id="mwDGg"><a rel="mw:ExtLink nofollow" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3718554" class="external text" id="mwDGk">3718554</a></span>. <a rel="mw:WikiLink" href="./PMID_(identifier)" title="PMID (identifier)" class="mw-redirect" id="mwDGo">PMID</a><span typeof="mw:Entity" id="mwDGs"> </span><a rel="mw:ExtLink nofollow" href="https://pubmed.ncbi.nlm.nih.gov/22700446" class="external text" id="mwDGw">22700446</a>. <q id="mwDG0">(referring to studies included in their review) "The general quality of these RCTs were acceptable as per CLEAR-NPT: sixteen (40%) studies had a quality score of 0.8 or better, indicating a good quality in research design (p. 5) . . . . the majority of existing reviews have applied evaluation criteria based on pharmaceutical RCT's that tended to underestimate the actual quality of these studies, since many of the traditional criteria for quality assessment may not apply to the study of meditative therapies (p. 3) . . . . the overall quality of meditation studies have increased continuously in the past 10 years. Our analysis of study quality over time indicates that studies published prior to 2000 had a relatively lower quality score (CLEAR=.66), studies published in 2000-2005 had a slightly higher score (CLEAR=.69), whereas studies published after 2006 has a mean quality score of .75 (p. 13)</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Depression+and+Anxiety&amp;rft.atitle=Meditative+Therapies+for+Reducing+Anxiety%3A+A+Systematic+Review+and+Meta-Analysis+of+Randomized+Controlled+Trials&amp;rft.volume=29&amp;rft.issue=7&amp;rft.pages=545-562&amp;rft.date=2012-06&amp;rft_id=https%3A%2F%2Fwww.ncbi.nlm.nih.gov%2Fpmc%2Farticles%2FPMC3718554%23id-name%3DPMC&amp;rft_id=info%3Apmid%2F22700446&amp;rft_id=info%3Adoi%2F10.1002%2Fda.21964&amp;rft.aulast=Chen&amp;rft.aufirst=Kevin+W.&amp;rft.au=Christine+C.+Berger&amp;rft_id=https%3A%2F%2Fwww.ncbi.nlm.nih.gov%2Fpmc%2Farticles%2FPMC3718554&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATranscendental+Meditation+technique" class="Z3988" about="#mwt448" id="mwDG4"></span></span></li>
<li about="#cite_note-126" id="cite_note-126" data-mw-footnote-number="126"><span class="mw-cite-backlink" id="mwDG8"><a href="./Transcendental_Meditation_technique#cite_ref-126" rel="mw:referencedBy" id="mwDHA"><span class="mw-linkback-text" id="mwDHE">↑</span></a></span> <span id="mw-reference-text-cite_note-126" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt451" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"first":{"wt":"R."},"last":{"wt":"Walsh"},"date":{"wt":"January 17, 2011"},"title":{"wt":"Lifestyle and Mental Health"},"quote":{"wt":"It is now clear that meditation, either alone or in combination with other therapies, can be beneficial for both normal and multiple clinical populations. (Cites Anderson, Liu, &amp; Kryscio, 2008, among others.)"},"journal":{"wt":"American Psychologist"},"pages":{"wt":"579–592"},"doi":{"wt":"10.1037/a0021769"},"pmid":{"wt":"21244124"},"volume":{"wt":"66"},"issue":{"wt":"7"},"s2cid":{"wt":"481301"},"url":{"wt":"https://escholarship.org/uc/item/0786x6tw"}},"i":0}}]}' id="mwDHI"/><cite id="CITEREFWalsh2011" class="citation journal cs1" about="#mwt451">Walsh, R. (January 17, 2011). <a rel="mw:ExtLink nofollow" href="https://escholarship.org/uc/item/0786x6tw" class="external text" id="mwDHM">"Lifestyle and Mental Health"</a>. <i id="mwDHQ">American Psychologist</i>. <b id="mwDHU">66</b> (7): <span class="nowrap" id="mwDHY">579–</span>592. <a rel="mw:WikiLink" href="./Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwDHc">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1037%2Fa0021769" class="external text" id="mwDHg">10.1037/a0021769</a>. <a rel="mw:WikiLink" href="./PMID_(identifier)" title="PMID (identifier)" class="mw-redirect" id="mwDHk">PMID</a><span typeof="mw:Entity" id="mwDHo"> </span><a rel="mw:ExtLink nofollow" href="https://pubmed.ncbi.nlm.nih.gov/21244124" class="external text" id="mwDHs">21244124</a>. <a rel="mw:WikiLink" href="./S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwDHw">S2CID</a><span typeof="mw:Entity" id="mwDH0"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:481301" class="external text" id="mwDH4">481301</a>. <q id="mwDH8">It is now clear that meditation, either alone or in combination with other therapies, can be beneficial for both normal and multiple clinical populations. (Cites Anderson, Liu, &amp; Kryscio, 2008, among others.)</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=American+Psychologist&amp;rft.atitle=Lifestyle+and+Mental+Health&amp;rft.volume=66&amp;rft.issue=7&amp;rft.pages=579-592&amp;rft.date=2011-01-17&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A481301%23id-name%3DS2CID&amp;rft_id=info%3Apmid%2F21244124&amp;rft_id=info%3Adoi%2F10.1037%2Fa0021769&amp;rft.aulast=Walsh&amp;rft.aufirst=R.&amp;rft_id=https%3A%2F%2Fescholarship.org%2Fuc%2Fitem%2F0786x6tw&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATranscendental+Meditation+technique" class="Z3988" about="#mwt451" id="mwDIA"></span></span></li>
<li about="#cite_note-127" id="cite_note-127" data-mw-footnote-number="127"><span class="mw-cite-backlink" id="mwDIE"><a href="./Transcendental_Meditation_technique#cite_ref-127" rel="mw:referencedBy" id="mwDII"><span class="mw-linkback-text" id="mwDIM">↑</span></a></span> <span id="mw-reference-text-cite_note-127" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt454" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"vauthors":{"wt":"Canter PH, Ernst E"},"title":{"wt":"Insufficient evidence to conclude whether or not Transcendental Meditation decreases blood pressure: results of a systematic review of randomized clinical trials"},"journal":{"wt":"Journal of Hypertension"},"volume":{"wt":"22"},"issue":{"wt":"11"},"pages":{"wt":"2049–54"},"date":{"wt":"November 2004"},"pmid":{"wt":"15480084"},"quote":{"wt":"All the randomized clinical trials of TM for the control of blood pressure published to date have important methodological weaknesses and are potentially biased by the affiliation of authors to the TM organization."},"doi":{"wt":"10.1097/00004872-200411000-00002"},"s2cid":{"wt":"22171451"}},"i":0}}]}' id="mwDIQ"/><cite id="mwDIU" class="citation journal cs1" about="#mwt454" data-x-id="CITEREFCanterErnst2004">Canter PH, Ernst E (November 2004). "Insufficient evidence to conclude whether or not Transcendental Meditation decreases blood pressure: results of a systematic review of randomized clinical trials". <i id="mwDIY">Journal of Hypertension</i>. <b id="mwDIc">22</b> (11): <span class="nowrap" id="mwDIg">2049–</span>54. <a rel="mw:WikiLink" href="./Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwDIk">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1097%2F00004872-200411000-00002" class="external text" id="mwDIo">10.1097/00004872-200411000-00002</a>. <a rel="mw:WikiLink" href="./PMID_(identifier)" title="PMID (identifier)" class="mw-redirect" id="mwDIs">PMID</a><span typeof="mw:Entity" id="mwDIw"> </span><a rel="mw:ExtLink nofollow" href="https://pubmed.ncbi.nlm.nih.gov/15480084" class="external text" id="mwDI0">15480084</a>. <a rel="mw:WikiLink" href="./S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwDI4">S2CID</a><span typeof="mw:Entity" id="mwDI8"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:22171451" class="external text" id="mwDJA">22171451</a>. <q id="mwDJE">All the randomized clinical trials of TM for the control of blood pressure published to date have important methodological weaknesses and are potentially biased by the affiliation of authors to the TM organization.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Journal+of+Hypertension&amp;rft.atitle=Insufficient+evidence+to+conclude+whether+or+not+Transcendental+Meditation+decreases+blood+pressure%3A+results+of+a+systematic+review+of+randomized+clinical+trials&amp;rft.volume=22&amp;rft.issue=11&amp;rft.pages=2049-54&amp;rft.date=2004-11&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A22171451%23id-name%3DS2CID&amp;rft_id=info%3Apmid%2F15480084&amp;rft_id=info%3Adoi%2F10.1097%2F00004872-200411000-00002&amp;rft.aulast=Canter&amp;rft.aufirst=PH&amp;rft.au=Ernst%2C+E&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATranscendental+Meditation+technique" class="Z3988" about="#mwt454" id="mwDJI"></span></span></li>
<li about="#cite_note-128" id="cite_note-128" data-mw-footnote-number="128"><span class="mw-cite-backlink" id="mwDJM"><a href="./Transcendental_Meditation_technique#cite_ref-128" rel="mw:referencedBy" id="mwDJQ"><span class="mw-linkback-text" id="mwDJU">↑</span></a></span> <span id="mw-reference-text-cite_note-128" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt457" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"vauthors":{"wt":"Canter PH, Ernst E"},"title":{"wt":"The cumulative effects of Transcendental Meditation on cognitive function--a systematic review of randomised controlled trials"},"journal":{"wt":"Wien. Klin. Wochenschr."},"volume":{"wt":"115"},"issue":{"wt":"21&amp;ndash;22"},"pages":{"wt":"758&amp;ndash;66"},"date":{"wt":"November 2003"},"pmid":{"wt":"14743579"},"doi":{"wt":"10.1007/BF03040500"},"s2cid":{"wt":"20166373"},"quote":{"wt":"All 4 positive trials recruited subjects from among people favourably predisposed towards TM, and used passive control procedures ... The association observed between positive outcome, subject selection procedure and control procedure suggests that the large positive effects reported in 4 trials result from an expectation effect. The claim that TM has a specific and cumulative effect on cognitive function is not supported by the evidence from randomized controlled trials."}},"i":0}}]}' id="mwDJY"/><cite id="mwDJc" class="citation journal cs1" about="#mwt457" data-x-id="CITEREFCanterErnst2003">Canter PH, Ernst E (November 2003). "The cumulative effects of Transcendental Meditation on cognitive function--a systematic review of randomised controlled trials". <i id="mwDJg">Wien. Klin. Wochenschr</i>. <b id="mwDJk">115</b> (<span class="