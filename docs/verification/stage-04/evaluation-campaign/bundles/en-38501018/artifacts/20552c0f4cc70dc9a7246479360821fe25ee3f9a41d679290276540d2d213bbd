<html prefix="dc: http://purl.org/dc/terms/ mw: http://mediawiki.org/rdf/" about="//en.wikipedia.org/wiki/Special:Redirect/revision/1386001833"><head prefix="mwr: //en.wikipedia.org/wiki/Special:Redirect/"><meta charset="utf-8"/><link rel="dc:replaces" resource="mwr:revision/1385945186"/><meta property="mw:revisionSHA1" content="knrz1rv8woxd9n7us47nmesjk8y4kkr"/><meta property="dc:modified" content="2026-11-16T09:20:54Z"/><meta property="mw:pageNamespace" content="0"/><meta property="mw:pageId" content="38501018"/><meta property="mw:htmlVersion" content="2.8.0"/><meta property="mw:html:version" content="2.8.0"/><base href="//en.wikipedia.org/wiki/"/><link rel="dc:isVersionOf" href="//en.wikipedia.org/wiki/Wegman_Report"/><title>Wegman Report</title><meta property="mw:jsConfigVars" content='{"wgParsoidHtmlVersion":"2.8.0"}'/><meta property="mw:generalModules" content="ext.cite.ux-enhancements|mediawiki.page.media|ext.scribunto.logs"/><meta property="mw:moduleStyles" content="ext.cite.parsoid.styles|ext.cite.styles"/><link rel="stylesheet" href="/w/load.php?lang=en&amp;modules=ext.cite.parsoid.styles%7Cext.cite.styles%7Cmediawiki.skinning.content.parsoid%7Cmediawiki.skinning.interface%7Csite.styles&amp;only=styles&amp;skin=vector"/><meta http-equiv="content-language" content="en"/><meta http-equiv="vary" content="Accept"/><meta http-equiv="x-mediawiki-render-id" content="24a0c0b6-e2e8-11f1-90e6-cf2062e5ba05"/></head><body class="mw-content-ltr sitedir-ltr ltr mw-body-content mediawiki mw-parser-output parsoid-body" lang="en" dir="ltr" data-mw-parsoid-version="0.25.0.0-alpha1" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><span class="mw-empty-elt" about="#mwt1" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"More footnotes needed","href":"./Template:More_footnotes_needed"},"params":{"date":{"wt":"November 2026"}},"i":0}}]}' id="mwAg"><style data-mw-deduplicate="TemplateStyles:r1384556748" typeof="mw:Extension/templates