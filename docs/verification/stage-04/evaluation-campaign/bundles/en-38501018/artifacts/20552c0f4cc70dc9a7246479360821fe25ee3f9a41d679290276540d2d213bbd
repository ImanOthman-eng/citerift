<li about="#cite_note-HCEC_Hearings,_19_and_27_July_2006_765–766-3" id="cite_note-HCEC_Hearings,_19_and_27_July_2006_765–766-3" data-mw-footnote-number="3"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwAvc"><a href="./Wegman_Report#cite_ref-HCEC_Hearings,_19_and_27_July_2006_765–766_3-0" id="mwAvg"><span class="mw-linkback-text" id="mwAvk">1</span></a> <a href="./Wegman_Report#cite_ref-HCEC_Hearings,_19_and_27_July_2006_765–766_3-1" id="mwAvo"><span class="mw-linkback-text" id="mwAvs">2</span></a></span> <span id="mw-reference-text-cite_note-HCEC_Hearings,_19_and_27_July_2006_765–766-3" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="./Wegman_Report#CITEREFHCEC_Hearings,_19_and_27_July2006" about="#mwt6" typeof="mw:Transclusion" class="mw-selflink-fragment" data-mw='{"parts":[{"template":{"target":{"wt":"Harvnb","href":"./Template:Harvnb"},"params":{"1":{"wt":"HCEC Hearings, 19 and 27 July"},"2":{"wt":"2006"},"pp":{"wt":"765–766"}},"i":0}}]}' id="mwAvw">HCEC Hearings, 19 and 27 July 2006</a><span about="#mwt6" id="mwAv0">, pp.</span><span typeof="mw:Entity" about="#mwt6" id="mwAv4"> </span><span about="#mwt6" id="mwAv8">765–766</span>.</span></li>
<li about="#cite_note-Fingerprints_(1990s-2000s)-4" id="cite_note-Fingerprints_(1990s-2000s)-4" data-mw-footnote-number="4"><span class="mw-cite-backlink" id="mwAwA"><a href="./Wegman_Report#cite_ref-Fingerprints_(1990s-2000s)_4-0" rel="mw:referencedBy" id="mwAwE"><span class="mw-linkback-text" id="mwAwI">↑</span></a></span> <span id="mw-reference-text-cite_note-Fingerprints_(1990s-2000s)-4" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="./Wegman_Report#CITEREFWeart2011c" about="#mwt11" typeof="mw:Transclusion" class="mw-selflink-fragment" data-mw='{"parts":[{"template":{"target":{"wt":"harvnb","href":"./Template:Harvnb"},"params":{"1":{"wt":"Weart"},"2":{"wt":"2011c"},"loc":{"wt":"[http://www.aip.org/history/climate/20ctrend.htm#S5 Fingerprints (1990s-2000s)]"}},"i":0}}]}' id="mwAwM">Weart 2011c</a><span about="#mwt11" id="mwAwQ">, </span><a rel="mw:ExtLink nofollow" href="http://www.aip.org/history/climate/20ctrend.htm#S5" about="#mwt11" class="external text" id="mwAwU">Fingerprints (1990s-2000s)</a></span></li>
