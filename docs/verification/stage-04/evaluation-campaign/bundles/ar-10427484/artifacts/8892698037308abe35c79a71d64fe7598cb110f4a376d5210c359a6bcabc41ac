m_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d7/Acropora_latistella_%28Table_coral%29.jpg/330px-Acropora_latistella_%28Table_coral%29.jpg?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="" data-file-width="2000" data-file-height="1500" data-file-type="bitmap" height="114" width="152" class="mw-file-element"/></a></span></div></div><div class="tsingle" style="width:154px;max-width:154px"><div class="thumbimage" style="border:none;;height:114px;overflow:hidden"><span typeof="mw:File"><a href="./ملف:Nembrotha_kubaryana.jpg" class="mw-file-description"><img resource="./ملف:Nembrotha_kubaryana.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d9/Nembrotha_kubaryana.jpg/250px-Nembrotha_kubaryana.jpg?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d9/Nembrotha_kubaryana.jpg/330px-Nembrotha_kubaryana.jpg?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="" data-file-width="2933" data-file-height="2200" data-file-type="bitmap" height="114" width="152" class="mw-file-element"/></a></span></div></div></div><div class="trow"><div class="tsingle" style="width:310px;max-width:310px"><div class="thumbimage" style="border:none;;height:230px;overflow:hidden"><span typeof="mw:File"><a href="./ملف:Reef_manta_at_Manta_Alley.JPG" class="mw-file-description"><img resource="./ملف:Reef_manta_at_Manta_Alley.JPG" src="//thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Reef_manta_at_Manta_Alley.JPG/330px-Reef_manta_at_Manta_Alley.JPG?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Reef_manta_at_Manta_Alley.JPG/960px-Reef_manta_at_Manta_Alley.JPG?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="" data-file-width="3431" data-file-height="2573" data-file-type="bitmap" height="231" width="308" class="mw-file-element"/></a></span></div></div></div><div class="trow" style="display:block"><div class="thumbcaption" style="text-align:center;display:block;margin-left:auto;margin-right:auto">Some of the species in the Coral Triangle region. Clockwise from the left: Table coral <i><a rel="mw:WikiLink" href="./قمي_المسام" title="قمي المسام">Acropora latistella</a></i>, <a rel="mw:WikiLink" href="./Sea_slug?action=edit&amp;redlink=1" title="Sea slug" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Sea slug"]}}'>sea slug</a> <i><a rel="mw:WikiLink" href="./Nembrotha_kubaryana?action=edit&amp;redlink=1" title="Nembrotha kubaryana" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Nembrotha kubaryana"]}}'>Nembrotha kubaryana</a></i>, <a rel="mw:WikiLink" href="./شفنين_طائر" title="شفنين طائر">شفنين طائر</a> ray, <a rel="mw:WikiLink" href="./لجأة_خضراء" title="لجأة خضراء">لجأة خضراء</a>، <a rel="mw:WikiLink" href="./Christmas_tree_worm?action=edit&amp;redlink=1" title="Christmas tree worm" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Christmas tree worm"]}}'>Christmas tree worms</a> (<i>Spirobranchus giganteus</i>) and a <a rel="mw:WikiLink" href="./سمكة_ببغائية" title="سمكة ببغائية">سمكة ببغائية</a></div></div></div></div><span class="mw-empty-elt" about="#mwt239"><link rel="mw:PageProp/Category" href="./تصنيف:صفحات_تستخدم_قالب_عدة_صور_بمقاس_تلقائي"/></span><p id="mwAr4">بحلول عام 2030، من المتوقع أن تغمر مياه البحر مساحات شاسعة من مدن هندية رئيسية مثل <a rel="mw:WikiLink" href="./مومباي" title="مومباي" id="mwAr8">مومباي</a> <a rel="mw:WikiLink" href="./كلكتا" title="كلكتا" id="mwAsA">وكلكتا</a> <a rel="mw:WikiLink" href="./كوتاك" title="كوتاك" class="mw-redirect" id="mwAsE">وكاتاك</a> <a rel="mw:WikiLink" href="./كوتشي_(كيرلا)" title="كوتشي (كيرلا)" id="mwAsI">وكوتشي</a>.<sup about="#mwt244" class="mw-ref reference" id="cite_ref-33" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-33"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-33" id="mwAsM"><span class="mw-reflink-text" id="mwAsQ"><span class="cite-bracket" id="mwAsU">[</span>33<span class="cite-bracket" id="mwAsY">]</span></span></a></sup> وفي مومباي وحدها، سيؤدي عدم التكيف مع هذا الوضع إلى خسائر تتراوح بين 112 و162 دولارًا أمريكيًا.<span typeof="mw:Entity" id="mwAsc"> </span>من المتوقع أن تصل الخسائر الناجمة عن الفيضانات إلى مليار دولار بحلول عام 2050، وهو ما سيتضاعف ثلاث مرات تقريبًا بحلول عام 2070.<sup about="#mwt245" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-49" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAsg"><span class="mw-reflink-text" id="mwAsk"><span class="cite-bracket" id="mwAso">[</span>3<span class="cite-bracket" id="mwAss">]</span></span></a></sup> ولذلك، تُنفذ السلطات مشاريع تكيف مثل طريق مومباي الساحلي، حتى وإن كان ذلك على حساب النظم البيئية الساحلية المحلية وسبل عيش الصيادين.<sup about="#mwt246" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-50" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAsw"><span class="mw-reflink-text" id="mwAs0"><span class="cite-bracket" id="mwAs4">[</span>3<span class="cite-bracket" id="mwAs8">]</span></span></a></sup> من بين 20 مدينة ساحلية يُتوقع أن تشهد أعلى خسائر الفيضانات بحلول عام 2050، تقع 13 مدينة في آسيا. تسع من هذه <a rel="mw:WikiLink" href="./مدن_مهددة_بالغرق" title="مدن مهددة بالغرق" id="mwAtA">المدن تُعرف باسم «المدن الغارقة»</a>، حيث <a rel="mw:WikiLink" href="./انخساف" title="انخساف" id="mwAtE">يُؤدي الهبوط الأرضي</a> (الذي ينتج عادةً عن استخراج <a rel="mw:WikiLink" href="./مياه_جوفية" title="مياه جوفية" id="mwAtI">المياه الجوفية</a> بشكل غير مستدام في الماضي) إلى تفاقم ارتفاع مستوى سطح البحر.<sup about="#mwt249" class="mw-ref reference" id="cite_ref-34" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-34"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-34" id="mwAtM"><span class="mw-reflink-text" id="mwAtQ"><span class="cite-bracket" id="mwAtU">[</span>34<span class="cite-bracket" id="mwAtY">]</span></span></a></sup> وهذه المدن هي: <a rel="mw:WikiLink" href="./بانكوك" title="بانكوك" id="mwAtc">بانكوك</a>، <a rel="mw:WikiLink" href="./غوانجو" title="غوانجو" class="mw-redirect" id="mwAtg">قوانغتشو</a>، <a rel="mw:WikiLink" href="./مدينة_هو_تشي_منه" title="مدينة هو تشي منه" id="mwAtk">مدينة هو تشي منه</a>، <a rel="mw:WikiLink" href="./جاكرتا" title="جاكرتا" id="mwAto">جاكرتا</a>، <a rel="mw:WikiLink" href="./كلكتا" title="كلكتا" id="mwAts">كلكتا</a>، <a rel="mw:WikiLink" href="./ناغويا" title="ناغويا" id="mwAtw">ناغويا</a>، <a rel="mw:WikiLink" href="./تيانجين" title="تيانجين" id="mwAt0">تيانجين</a>، <a rel="mw:WikiLink" href="./شيامن" title="شيامن" id="mwAt4">شيامن</a>، <a rel="mw:WikiLink" href="./زانجيانغ" title="زانجيانغ" id="mwAt8">وتشانجيانغ</a>.<sup about="#mwt250" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-51" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAuA"><span class="mw-reflink-text" id="mwAuE"><span class="cite-bracket" id="mwAuI">[</span>3<span class="cite-bracket" id="mwAuM">]</span></span></a></sup></p>

<p id="mwAuQ">بحلول عام 2050، ستشهد مدينة قوانغتشو ارتفاعًا في مستوى سطح البحر بمقدار 0.2 متر، وخسائر اقتصادية سنوية تُقدّر بنحو 254 مليون دولار أمريكي، وهي الأعلى في العالم. وتشير إحدى التقديرات إلى أنه في حال عدم اتخاذ إجراءات للتكيف، ستصل الخسائر الاقتصادية التراكمية الناجمة عن ارتفاع مستوى سطح البحر في قوانغتشو، وفقًا لسيناريو RCP8.5 ، إلى حوالي 331 مليون دولار أمريكي.<span typeof="mw:Entity" id="mwAuU"> </span>مليار دولار بحلول عام 2050، 660 دولار أمريكي<span typeof="mw:Entity" id="mwAuY"> </span>مليار دولار بحلول عام 2070 و1.4 مليار دولار أمريكي<span typeof="mw:Entity" id="mwAuc"> </span>تريليون دولار بحلول عام 2100. وسيؤدي تأثير عدم استقرار <a rel="mw:WikiLink" href="./صفيحة_جليدية" title="صفيحة جليدية" id="mwAug">الصفائح الجليدية</a> على نطاق واسع إلى زيادة هذه الأرقام إلى حوالي 420 دولارًا أمريكيًا.<span typeof="mw:Entity" id="mwAuk"> </span>مليار دولار، 840 دولار أمريكي<span typeof="mw:Entity" id="mwAuo"> </span>مليار و1.8 مليار دولار أمريكي<span typeof="mw:Entity" id="mwAus"> </span>تريليون على التوالي.<sup about="#mwt252" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-52" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAuw"><span class="mw-reflink-text" id="mwAu0"><span class="cite-bracket" id="mwAu4">[</span>3<span class="cite-bracket" id="mwAu8">]</span></span></a></sup> في <a rel="mw:WikiLink" href="./شانغهاي" title="شانغهاي" id="mwAvA">شنغهاي</a>، تبلغ تكلفة الفيضانات الساحلية حوالي 0.03% من <a rel="mw:WikiLink" href="./ناتج_محلي_إجمالي" title="ناتج محلي إجمالي" id="mwAvE">الناتج</a> المحلي الإجمالي. لكن هذه النسبة سترتفع إلى 0.8% بحلول عام 2100 حتى في ظل سيناريو <a rel="mw:WikiLink" href="./مسار_تركيز_تمثيلي" title="مسار تركيز تمثيلي" id="mwAvI">RCP4.5</a> "المعتدل" في حال عدم اتخاذ إجراءات للتكيف.<sup about="#mwt253" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-53" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAvM"><span class="mw-reflink-text" id="mwAvQ"><span class="cite-bracket" id="mwAvU">[</span>3<span class="cite-bracket" id="mwAvY">]</span></span></a></sup> مدينة جاكرتا <a rel="mw:WikiLink" href="./الفيضانات_في_جاكرتا" title="الفيضانات في جاكرتا" id="mwAvc">تغرق</a> بشكل كبير (حتى <span about="#mwt251" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"حول مختصر","href":"./قالب:حول_مختصر"},"params":{"1":{"wt":"28"},"2":{"wt":"cm"},"3":{"wt":"in"}},"i":0}}]}' id="mwAvg">28</span><span typeof="mw:Entity" about="#mwt251"> </span><span about="#mwt251">سـم (11</span><span typeof="mw:Entity" about="#mwt251"> </span><span about="#mwt251">بوصة)</span> سنويًا بين عامي 1982 و2010 في بعض المناطق)<sup about="#mwt256" class="mw-ref reference" id="cite_ref-35" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-35"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-35" id="mwAvk"><span class="mw-reflink-text" id="mwAvo"><span class="cite-bracket" id="mwAvs">[</span>35<span class="cite-bracket" id="mwAvw">]</span></span></a></sup> أنه في عام 2019، التزمت الحكومة بنقل <a rel="mw:WikiLink" href="./عاصمة_إندونيسيا" title="عاصمة إندونيسيا" id="mwAv0">عاصمة إندونيسيا</a> إلى مدينة أخرى.<sup about="#mwt259" class="mw-ref reference" id="cite_ref-36" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-36"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-36" id="mwAv4"><span class="mw-reflink-text" id="mwAv8"><span class="cite-bracket" id="mwAwA">[</span>36<span class="cite-bracket" id="mwAwE">]</span></span></a></sup></p>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwAwI"><a href="./ملف:Choi_2021_Hallasan_fir.png" class="mw-file-description" id="mwAwM"><img resource="./ملف:Choi_2021_Hallasan_fir.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Choi_2021_Hallasan_fir.png/250px-Choi_2021_Hallasan_fir.png?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Choi_2021_Hallasan_fir.png/500px-Choi_2021_Hallasan_fir.png?utm_source=ar.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="959" data-file-height="1215" data-file-type="bitmap" height="317" width="250" class="mw-file-element" id="mwAwQ"/></a><figcaption id="mwAwU">سينخفض انتشار شجرة التنوب الكورية في موطنها الأساسي، جبل <a rel="mw:WikiLink" href="./هالاسان" title="هالاسان" id="mwAwY">هالاسان</a>، في ظل <span about="#mwt260" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"حول","href":"./قالب:حول"},"params":{"1":{"wt":"2"},"2":{"wt":"C-change"},"3":{"wt":"F-change"}},"i":0}}]}' id="mwAwc">2</span><span typeof="mw:Entity" about="#mwt260"> </span><span about="#mwt260">°م (3.6</span><span typeof="mw:Entity" about="#mwt260"> </span><span about="#mwt260">°ف)</span> الاحترار المحلي مقارنة بالوضع الحالي.<sup about="#mwt263" class="mw-ref reference" id="cite_ref-37" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-37"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-37" id="mwAwg"><span class="mw-reflink-text" id="mwAwk"><span class="cite-bracket" id="mwAwo">[</span>37<span class="cite-bracket" id="mwAws">]</span></span></a></sup></figcaption></figure>
<p id="mwAww">شهدت العديد من <a rel="mw:WikiLink" href="./حيوم" title="حيوم" id="mwAw0">المناطق الأحيائية</a> في آسيا تحولات واضحة استجابةً لتغير المناخ. وتشمل هذه التحولات تغيرات في طول موسم النمو، وفقدان <a rel="mw:WikiLink" href="./موطن" title="موطن" id="mwAw4">الموائل</a> (وخاصة موائل أنواع <a rel="mw:WikiLink" href="./برمائيات" title="برمائيات" id="mwAw8">البرمائيات</a> <sup about="#mwt274" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-54" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAxA"><span class="mw-reflink-text" id="mwAxE"><span class="cite-bracket" id="mwAxI">[</span>3<span class="cite-bracket" id="mwAxM">]</span></span></a></sup> <sup class="reference" style="white-space:nowrap;" about="#mwt264" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1473"}},"i":0}}]}' id="mwAxQ">:1473</sup>) أو زيادة تواتر <a rel="mw:WikiLink" href="./نوع_مجتاح" title="نوع مجتاح" id="mwAxU">الأنواع الغازية</a>.<sup about="#mwt275" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-55" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAxY"><span class="mw-reflink-text" id="mwAxc"><span class="cite-bracket" id="mwAxg">[</span>3<span class="cite-bracket" id="mwAxk">]</span></span></a></sup> <sup class="reference" style="white-space:nowrap;" about="#mwt265" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1476"}},"i":0}}]}' id="mwAxo">:1476</sup>لوحظ انتقال العديد من أنواع الحيوانات إلى المناطق الدافئة شمالًا.<sup about="#mwt276" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-56" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAxs"><span class="mw-reflink-text" id="mwAxw"><span class="cite-bracket" id="mwAx0">[</span>3<span class="cite-bracket" id="mwAx4">]</span></span></a></sup> <sup class="reference" style="white-space:nowrap;" about="#mwt266" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1473"}},"i":0}}]}' id="mwAx8">:1473</sup>في سيبيريا، يتقلص امتداد <a rel="mw:WikiLink" href="./تندرة" title="تندرة" id="mwAyA">التندرا</a> تدريجياً مع استبدالها بالغابات الشمالية ( <a rel="mw:WikiLink" href="./تايغا" title="تايغا" id="mwAyE">التايغا</a> )<sup class="reference" style="white-space:nowrap;" about="#mwt267" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1472"}},"i":0}}]}' id="mwAyI">:1472</sup> <sup about="#mwt277" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-57" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAyM"><span class="mw-reflink-text" id="mwAyQ"><span class="cite-bracket" id="mwAyU">[</span>3<span class="cite-bracket" id="mwAyY">]</span></span></a></sup><sup class="reference" style="white-space:nowrap;" about="#mwt268" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1472"}},"i":0}}]}' id="mwAyc">:1472</sup>في الوقت نفسه، أصبحت حرائق الغابات أكثر حدة في سيبيريا، على الرغم من أن هذا يرتبط جزئياً بزيادة الضغط الناتج عن <a rel="mw:WikiLink" href="./هندسة_التعدين" title="هندسة التعدين" id="mwAyg">التنقيب عن المعادن</a> <a rel="mw:WikiLink" href="./قطع_الأشجار" title="قطع الأشجار" id="mwAyk">وقطع الأشجار</a> غير القانوني.<sup about="#mwt278" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-58" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAyo"><span class="mw-reflink-text" id="mwAys"><span class="cite-bracket" id="mwAyw">[</span>3<span class="cite-bracket" id="mwAy0">]</span></span></a></sup> <sup class="reference" style="white-space:nowrap;" about="#mwt269" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1474"}},"i":0}}]}' id="mwAy4">:1474</sup>وقد سهّل ارتفاع درجات الحرارة بشكل عام انتقال الأشجار إلى المناطق الجبلية التي كانت غير مناسبة لها سابقاً، ومن المتوقع أن يستمر هذا الاتجاه في المستقبل<sup class="reference" style="white-space:nowrap;" about="#mwt270" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1472"}},"i":0}}]}' id="mwAy8">:1472</sup> <sup about="#mwt279" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-59" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAzA"><span class="mw-reflink-text" id="mwAzE"><span class="cite-bracket" id="mwAzI">[</span>3<span class="cite-bracket" id="mwAzM">]</span></span></a></sup><sup class="reference" style="white-space:nowrap;" about="#mwt271" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1472"}},"i":0}}]}' id="mwAzQ">:1472</sup>وقد يؤدي ذلك أيضاً إلى استبدال النظم البيئية الجبلية القائمة، مثل غابات التنوب الكورية، بنظم بيئية أكثر اعتدالاً <sup class="reference" style="white-space:nowrap;" about="#mwt272" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1475"}},"i":0}}]}' id="mwAzU">:1475</sup> <sup about="#mwt280" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-60" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAzY"><span class="mw-reflink-text" id="mwAzc"><span class="cite-bracket" id="mwAzg">[</span>3<span class="cite-bracket" id="mwAzk">]</span></span></a></sup><sup class="reference" style="white-space:nowrap;" about="#mwt273" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1475"}},"i":0}}]}' id="mwAzo">:1475</sup></p>

<p id="mwAzs">ستفقد بعض أنواع أسماك المياه العذبة أجزاءً من نطاق انتشارها<sup class="reference" style="white-space:nowrap;" about="#mwt281" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1477"}},"i":0}}]}' id="mwAzw">:1477</sup><sup about="#mwt288" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-61" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwAz0"><span class="mw-reflink-text" id="mwAz4"><span class="cite-bracket" id="mwAz8">[</span>3<span class="cite-bracket" id="mwA0A">]</span></span></a></sup><sup class="reference" style="white-space:nowrap;" about="#mwt282" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1477"}},"i":0}}]}' id="mwA0E">:1477</sup>تتعرض العديد من <a rel="mw:WikiLink" href="./نظام_بيئي" title="نظام بيئي" id="mwA0I">النظم البيئية</a> البحرية والساحلية لخطر الفقدان الذي لا رجعة فيه بعد فترة وجيزة من الاحترار. ومن الأمثلة البارزة على ذلك مروج الأعشاب البحرية الساحلية، التي تتدهور بمعدل 7% سنوياً، وغابات <a rel="mw:WikiLink" href="./أيكة_ساحلية" title="أيكة ساحلية" id="mwA0M">المانغروف</a> ، التي يقع 42% منها في آسيا <sup class="reference" style="white-space:nowrap;" about="#mwt283" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1480"}},"i":0}}]}' id="mwA0Q">:1480</sup> <sup about="#mwt289" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-62" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwA0U"><span class="mw-reflink-text" id="mwA0Y"><span class="cite-bracket" id="mwA0c">[</span>3<span class="cite-bracket" id="mwA0g">]</span></span></a></sup><sup class="reference" style="white-space:nowrap;" about="#mwt284" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1480"}},"i":0}}]}' id="mwA0k">:1480</sup>بحلول عام 2018، فُقد أكثر من 60% من مساحة أشجار المانغروف السابقة في آسيا و40% من الشعاب المرجانية<sup class="reference" style="white-space:nowrap;" about="#mwt285" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1482"}},"i":0}}]}' id="mwA0o">:1482</sup> <sup about="#mwt290" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-63" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwA0s"><span class="mw-reflink-text" id="mwA0w"><span class="cite-bracket" id="mwA00">[</span>3<span class="cite-bracket" id="mwA04">]</span></span></a></sup><sup class="reference" style="white-space:nowrap;" about="#mwt286" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1482"}},"i":0}}]}' id="mwA08">:1482</sup>في نفس وقت المد ، قد يصبح ازدهار طحلب السرجاسوم هورنيري «المد الذهبي» أكثر تواتراً.<sup about="#mwt291" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-64" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwA1A"><span class="mw-reflink-text" id="mwA1E"><span class="cite-bracket" id="mwA1I">[</span>3<span class="cite-bracket" id="mwA1M">]</span></span></a></sup><sup class="reference" style="white-space:nowrap;" about="#mwt287" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1481"}},"i":0}}]}' id="mwA1Q">:1481</sup></p><p id="mwA1U">

يوجد في <a rel="mw:WikiLink" href="./بحر_الصين_الجنوبي" title="بحر الصين الجنوبي" id="mwA1Y">بحر الصين الجنوبي</a> وحده ما يقرب من 600 نوع من المرجان، وقد تأثرت هذه الأنواع بشدة بتغير المناخ والأنشطة البشرية الأخرى.<sup about="#mwt300" class="mw-ref reference" id="cite_ref-AR6_WGII_Chapter10_3-65" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"AR6_WGII_Chapter10"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-AR6_WGII_Chapter10-3" id="mwA1c"><span class="mw-reflink-text" id="mwA1g"><span class="cite-bracket" id="mwA1k">[</span>3<span class="cite-bracket" id="mwA1o">]</span></span></a></sup> <sup class="reference" style="white-space:nowrap;" about="#mwt292" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"صفحات مرجع","href":"./قالب:صفحات_مرجع"},"params":{"1":{"wt":"1478"}},"i":0}}]}' id="mwA1s">:1478</sup>بشكل عام، ستشهد الشعاب المرجانية المتبقية خسائر لا رجعة فيها بعد فترة وجيزة من <span about="#mwt293" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"حول","href":"./قالب:حول"},"params":{"1":{"wt":"1.5"},"2":{"wt":"C-change"},"3":{"wt":"F-change"}},"i":0}}]}' id="mwA1w">1.5</span><span typeof="mw:Entity" about="#mwt293"> </span><span about="#mwt293">°م (2.7</span><span typeof="mw:Entity" about="#mwt293"> </span><span about="#mwt293">°ف)</span><sup about="#mwt301" class="mw-ref reference" id="cite_ref-ArmstrongMcKay2022_4-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ArmstrongMcKay2022"}}'><a href="./تغير_المناخ_في_آسيا#cite_note-ArmstrongMcKay2022-4" id="mwA10"><span class="mw-reflink-text" id="mwA14"><span class="cite-bracket" id="mwA18">[</span>4<span class="cite-bracket" id="mwA2A">]</span></span></a></sup><sup about="#mwt302" class="mw-ref reference" id="cite_ref-ArmstrongMcKayExplainer_5-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ArmstrongMcKayExplainer"}}'><a href="./تغير_المناخ_في_آسيا#cite