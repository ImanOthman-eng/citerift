رة":{"wt":"Cardiac amyloidosis very high mag movat.jpg"},"تعليق":{"wt":"[[صورة مجهرية]] للقلب مع [[تليف]] (أصفر) و[[داء نشواني قلبي]]. [[صبغة موفات]]."},"عوامل الخطر":{"wt":"[[السكري|داء السكري]]، ارتفاع نسبة الدهون في الدم، ضعف الوزن، التدخين، الإفراط في تعاطي المخدرات، الإفراط في تناول الكحول"},"الأعراض":{"wt":"ألم في الصدر، ضيق في التنفس، إرهاق، فقدان للوعي"},"المضاعفات":{"wt":"[[قصور القلب|فشل القلب]]، النوبة القلبية، [[سكتة دماغية|السكتة الدماغية]]، تمدد الأوعية الدموية، أمراض الشرايين الطرفية، السكتة القلبية المفاجئة."},"الوقاية":{"wt":"الأكل الصحي، ممارسة الرياضة، تجنب التدخين، الامتناع عن تعاطي اللكحول  تغييرات عامة في نمط الحياة"},"أدوية":{"wt":"علاج ارتفاع ضغط الدم وارتفاع نسبة الدهون في الدم والسكري، الأسبرين، حاصرات بيتا، مميعات الدم"},"الوفيات":{"wt":"17.9 مليون / 32% (2015)"},"أنواع":{"wt":"أمراض الشرايين التاجية، السكتة الدماغية، فشل القلب، مرض القلب الناتج عن ارتفاع ضغط الدم، أمراض القلب الروماتيزمية، اعتلال عضلة القلب، عدم انتظام ضربات القلب"},"اختصاص":{"wt":"طب القلب"}},"i":0}}]}' id="mwAg"><style data-mw-deduplicate="TemplateStyles:r77135834" typeof="mw:Extension/templatestyles" about="#mwt2" data-mw='{"name":"templatestyles","attrs":{"src":"بطاقة/icones.css"}}'>.mw-parser-output .entete{background-position:right center;background-repeat:no-repeat}.mw-parser-output .entete.aerostat{background-image:url("//upload.wikimedia.org/wikipedia/commons/7/7e/Picto_infobox_aerostat.png")}.mw-parser-output .entete.aikido{background-image:url("//thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Aikido_pictogram.svg/40px-Aikido_pictogram.svg.png")}.mw-parser-output .entete.alpinisme{background-image:url("//upload.wikimedia.org/wikipedia/commons/d/df/Picto_infobox_alpinisme.png")}.mw-parser-output .entete.arbitre{background-image:url("//thumb.wikimedia.org/wikipedia/commons/thumb/a/a7/Referee_football_pictogram.svg/35px-Referee_football_pictogram.svg.png")}.mw-parser-output .entete.arc{background-image:url("//thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Arche