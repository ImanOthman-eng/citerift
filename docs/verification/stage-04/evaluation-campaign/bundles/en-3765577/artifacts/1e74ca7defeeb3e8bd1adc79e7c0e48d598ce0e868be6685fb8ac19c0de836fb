former medical researcher</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox person\n","href":"./Template:Infobox_person"},"params":{"name":{"wt":"Jon Sudbø"},"image":{"wt":"&lt;!-- just the name, without the File: or Image: prefix or enclosing [[brackets]] -->"},"alt":{"wt":""},"caption":{"wt":""},"birth_name":{"wt":""},"birth_date":{"wt":"{{Birth date and age|1961|5|3|df=y}}"},"birth_place":{"wt":""},"death_date":{"wt":"&lt;!-- {{Death date and age|YYYY|MM|DD|1961|5|3|df=y}} -->"},"death_place":{"wt":""},"other_names":{"wt":""},"known_for":{"wt":"[[Scientific fraud]]"},"occupation":{"wt":"Dentist and physician"}},"i":0}}]}' id="mwAw"><style data-mw-deduplicate="TemplateStyles:r1385617415" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:var(--color-base)}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:var(--color-base)}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin