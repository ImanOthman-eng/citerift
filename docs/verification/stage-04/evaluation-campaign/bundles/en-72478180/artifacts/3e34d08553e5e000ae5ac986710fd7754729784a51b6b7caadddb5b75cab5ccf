n{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style></span><table class="infobox biography vcard" about="#mwt2"><tbody><tr><th colspan="2" class="infobox-above"><div class="fn">Garth David Ehrlich</div></th></tr><tr><th scope="row" class="infobox-label">Occupations</th><td class="infobox-data role"><a rel="mw:WikiLink" href="./Molecular_biology" title="Molecular biology">Molecular biologist</a>, <a rel="mw:WikiLink" href="./Genomics" title="Genomics">genomic</a> scientist, academic, and author</td></tr><tr class="infobox-hiddenrow"><td colspan="2" class="infobox-full-data"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1385617415" about="#mwt4" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'/></td></tr><tr><th colspan="2" class="infobox-header">Academic background</th></tr><tr><th scope="row" class="infobox-label">Education</th><td class="infobox-data">BA, and PhD</td></tr><tr><th scope="row" class="infobox-label"><span class="nowrap"><a rel="mw:WikiLink" href="./Alma_mater" title="Alma mater">Alma mater</a></span></th><td class="infobox-data"><a rel="mw:WikiLink" href="./Alfred_University" title="Alfred University">Alfred University</a><br/><a rel="mw:WikiLink" href="./Syracuse_University" title="Syracuse University">Syracuse University</a></td><style data-mw-deduplicate="TemplateStyles:r1385617415" typeof="mw:Extension/templatestyles" about="#mwt5" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'></style></tr><tr><th colspan="2" class="infobox-header">Academic work</th></tr><tr><th scope="row" class="infobox-label">Institutions</th><td class="infobox-data"><a rel="mw:Wik