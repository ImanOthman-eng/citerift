g%3A%D8%B3%D8%B1%D8%B7%D8%A7%D9%86+%D8%A7%D9%84%D8%A8%D8%B1%D9%88%D8%B3%D8%AA%D8%A7%D8%AA%D8%A7" class="Z3988" about="#mwt682" id="mwEAM"></span></span></li>
<li about="#cite_note-MEDRS_review_1-177" id="cite_note-MEDRS_review_1-177" data-mw-footnote-number="177"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwEAQ"><a href="./سرطان_البروستاتا#cite_ref-MEDRS_review_1_177-0" id="mwEAU"><span class="mw-linkback-text" id="mwEAY">1</span></a> <a href="./سرطان_البروستاتا#cite_ref-MEDRS_review_1_177-1" id="mwEAc"><span class="mw-linkback-text" id="mwEAg">2</span></a> <a href="./سرطان_البروستاتا#cite_ref-MEDRS_review_1_177-2" id="mwEAk"><span class="mw-linkback-text" id="mwEAo">3</span></a></span> <span id="mw-reference-text-cite_note-MEDRS_review_1-177" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r70318604" about="#mwt685" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"استشهاد بدورية محكمة","href":"./قالب:استشهاد_بدورية_محكمة"},"params":{"مؤلف":{"wt":"Greene ER, Huang S, Serhan CN, Panigrahy D"},"عنوان":{"wt":"Regulation of inflammation in cancer by eicosanoids"},"صحيفة":{"wt":"Prostaglandins Other Lipid Mediat."},"المجلد":{"wt":"96"},"العدد":{"wt":"1-4"},"صفحات":{"wt":"27–36"},"تاريخ":{"wt":"November 2011"},"pmid":{"wt":"21864702"},"pmc":{"wt":"4051344"},"doi":{"wt":"10.1016/j.prostaglandins.2011.08.004"},"اقتباس":{"wt":"The 5-lipoxygenase (5-LOX) pathway is implicated in the development and progression of human cancers. 5-LOX, whose crystal structure was recently identified (118), is a key enzyme in metabolizing arachidonic acid to leukotrienes. 5-LOX can be induced by pro-inflammatory stimuli and is expressed in epithelial cancers including lung, prostate, breast, and colon (113). Hence, 5-LOX inhibitors have been targeted for their chemopreventive effects. Inhibition of 5-LOX activity is shown to block prostate cancer cell proliferation as well as carcinogen-induced lung tumorigenesis (119, 120).&amp;nbsp;... Both 5-HETE and 12-HETE are also products of lipoxygenase and are involved in tumor progression (12). Exogenous 5-HETE can stimulate the proliferation of prostate cancer cells and act as a survival factor (137, 138). These results require relatively high concentrations (at a concentration of 10 μM). Blocking the formation of 5-HETE, by inhibiting 5-lipoxygenase, results in massive apoptosis of human prostate cancer cells (139)."}},"i":0}}]}' id="mwEAs"/><cite id="CITEREFGreene_ER,_Huang_S,_Serhan_CN,_Panigrahy_D2011" class="citation journal cs1" about="#mwt685">Greene ER, Huang S, Serhan CN, Panigrahy D (نوفمبر 2011). <a rel="mw:ExtLink nofollow" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4051344" class="external text" id="mwEAw">"Regulation of inflammation in cancer by eicosanoids"</a>. <i id="mwEA0">Prostaglandins Other Lipid Mediat</i>. ج.<span typeof="mw:Entity" id="mwEA4"> </span>96 ع.<span typeof="mw:Entity" id="mwEA8"> </span><span class="nowrap" id="mwEBA">1–</span>4: <span class="nowrap" id="mwEBE">27–</span>36. <a rel="mw:WikiLink" href="./معرف_الغرض_الرقمي" title="معرف الغرض الرقمي" id="mwEBI">DOI</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1016%2Fj.prostaglandins.2011.08.004" class="external text" id="mwEBM">10.1016/j.prostaglandins.2011.08.004</a>. <a rel="mw:WikiLink" href="./ببمد_سنترال" title="ببمد سنترال" id="mwEBQ">PMC</a>:<span class="id-lock-free" title="يمكن الوصول إليها بحرية" id="mwEBU"><a rel="mw:ExtLink nofollow" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4051344" class="external text" id="mwEBY">4051344</a></span>. <a rel="mw:WikiLink" href="./ببمد" title="ببمد" id="mwEBc">PMID</a>:<a rel="mw:ExtLink nofollow" href="https://pubmed.ncbi.nlm.nih.gov/21864702" class="external text" id="mwEBg">21864702</a>. <q id="mwEBk">The 5-lipoxygenase (5-LOX) pathway is implicated in the development and progression of human cancers. 5-LOX, whose crystal structure was recently identified (118), is a key enzyme in metabolizing arachidonic acid to leukotrienes. 5-LOX can be induced by pro-inflammatory stimuli and is expressed in epithelial cancers including lung, prostate, breast, and colon (113). Hence, 5-LOX inhibitors have been targeted for their chemopreventive effects. Inhibition of 5-LOX activity is shown to block prostate cancer cell proliferation as well as carcinogen-induced lung tumorigenesis (119, 120).<span typeof="mw:Entity" id="mwEBo"> </span>... Both 5-HETE and 12-HETE are also products of lipoxygenase and are involved in tumor progression (12). Exogenous 5-HETE can stimulate the proliferation of prostate cancer cells and act as a survival factor (137, 138). These results require relatively high concentrations (at a concentration of 10 μM). Blocking the formation of 5-HETE, by inhibiting 5-lipoxygenase, results in massive apoptosis of human prostate cancer cells (139).</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Prostaglandins+Other+Lipid+Mediat.&amp;rft.atitle=Regulation+of+inflammation+in+cancer+by+eicosanoids&amp;rft.volume=96&amp;rft.issue=%3Cspan+class%3D%22nowrap%22%3E1%E2%80%93%3C%2Fspan%3E4&amp;rft.pages=%3Cspan+class%3D%22nowrap%22%3E27-%3C%2Fspan%3E36&amp;rft.date=2011-11&amp;rft_id=https%3A%2F%2Fwww.ncbi.nlm.nih.gov%2Fpmc%2Farticles%2FPMC4051344%23id-name%3DPMC&amp;rft_id=info%3Apmid%2F21864702&amp;rft_id=info%3Adoi%2F10.1016%2Fj.prostaglandins.2011.08.004&amp;rft.au=Greene+ER%2C+Huang+S%2C+Serhan+CN%2C+Panigrahy+D&amp;rft_id=https%3A%2F%2Fwww.ncbi.nlm.nih.gov%2Fpmc%2Farticles%2FPMC4051344&amp;rfr_id=info%3Asid%2Far.wikipedia.org%3A%D8%B3%D8%B1%D8%B7%D8%A7%D9%86+%D8%A7%D9%84%D8%A8%D8%B1%D9%88%D8%B3%D8%AA%D8%A7%D8%AA%D8%A7" class="Z3988" about="#mwt685" id="mwEBs"></span><span class="cs1-maint citation-comment" about="#mwt685" id="mwEBw"><code class="cs1-code" id="mwEB0">{{<a rel="mw:WikiLink" href="./قالب:استشهاد_بدورية_محكمة" title="قالب:استشهاد بدورية محكمة" id="mwEB4">استشهاد بدورية محكمة</a>}}</code>:  صيانة الاستشهاد: أسماء متعددة: قائمة المؤلفين (<a rel="mw:WikiLink" href="./تصنيف:صيانة_الاستشهاد:_أسماء_متعددة:_قائمة_المؤلفين" title="تصنيف:صيانة الاستشهاد: أسماء متعددة: قائمة المؤلفين" id="mwEB8">link</a>)</span><link rel="mw:PageProp/Category" href="./تصنيف:صيانة_الاستشهاد:_أسماء_متعددة:_قائمة_المؤلفين" about="#mwt685" id="mwECA"/></span></li>
<li about="#cite_note-MEDRS_review_2-178" id="cite_note-MEDRS_review_2-178" data-mw-footnote-number="178"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwECE"><a href="./سرطان_البروستاتا#cite_ref-MEDRS_review_2_178-0" id="mwECI"><span class="mw-linkback-text" id="mwECM">1</span></a> <a href="./سرطان_البروستاتا#cite_ref-MEDRS_review_2_178-1" id="mwECQ"><span class="mw-linkback-text" id="mwECU">2</span></a> <a href="./سرطان_البروستاتا#cite_ref-MEDRS_review_2_178-2" id="mwECY"><span class="mw-linkback-text" id="mwECc">3</span></a></span> <span id="mw-reference-text-cite_note-MEDRS_review_2-178" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r70318604" about="#mwt689" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"استشهاد بدورية محكمة","href":"./قالب:استشهاد_بدورية_محكمة"},"params":{"مؤلف":{"wt":"Bishayee K, Khuda-Bukhsh AR"},"عنوان":{"wt":"5-lipoxygenase antagonist therapy: a new approach towards targeted cancer chemotherapy"},"صحيفة":{"wt":"Acta Biochim. Biophys. Sin. (Shanghai)"},"المجلد":{"wt":"45"},"العدد":{"wt":"9"},"صفحات":{"wt":"709–719"},"تاريخ":{"wt":"September 2013"},"pmid":{"wt":"23752617"},"doi":{"wt":"10.1093/abbs/gmt064"},"اقتباس":{"wt":"Recent studies demonstrated the involvement of growth factors, such as epidermal growth factor (EGF) and neurotensin in the 5-LOX-mediated tumor progression in prostate cancer [22,23]. Recent studies with 5-LOX siRNA [10] and specific blocker of 5-LOX [24] revealed the relation of this gene with the tumor cell proliferation.&amp;nbsp;... Meclofenamate sodium (MS) is known for its anti-inflammatory activity, and apart from this, Boctor et al. [37] reported that it caused reduction in the formation of 5-HETE in human leucocytes when used. MS can thus be considered a dual inhibitor of 5-LOX and COX pathways of arachidonic acid cascade. Further investigation with this substance revealed that it could interfere with the LT receptors in the lung carcinoma [38]. In a recent study, a group of scientists have shown the effect of MS on prostate cancer cells both in vitro and in vivo [39], and their result suggests a profound reduction in the tumor growth and cancer metastasis.&amp;nbsp;... While the commonly used inhibitors produced strong cytotoxicity, notably, zileuton, the only commercialized 5-LOX inhibitor, failed to induce an anti-proliferative or cytotoxic response in all other types of tumor cells where 5-LOX was in inactive state (e.g. HeLa cells); however, where 5-LOX was in active state, zileuton could effectively inhibit progression, as in case of prostate cancer."}},"i":0}}]}' id="mwECg"/><cite id="CITEREFBishayee_K,_Khuda-Bukhsh_AR2013" class="citation journal cs1" about="#mwt689">Bishayee K, Khuda-Bukhsh AR (سبتمبر 2013). "5-lipoxygenase antagonist therapy: a new approach towards targeted cancer chemotherapy". <i id="mwECk">Acta Biochim. Biophys. Sin. (Shanghai)</i>. ج.<span typeof="mw:Entity" id="mwECo"> </span>45 ع.<span typeof="mw:Entity" id="mwECs"> </span>9: <span class="nowrap" id="mwECw">709–</span>719. <a rel="mw:WikiLink" href="./معرف_الغرض_الرقمي" title="معرف الغرض الرقمي" id="mwEC0">DOI</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1093%2Fabbs%2Fgmt064" class="external text" id="mwEC4">10.1093/abbs/gmt064</a>. <a rel="mw:WikiLink" href="./ببمد" title="ببمد" id="mwEC8">PMID</a>:<a rel="mw:ExtLink nofollow" href="https://pubmed.ncbi.nlm.nih.gov/23752617" class="external text" id="mwEDA">23752617</a>. <q id="mwEDE">Recent studies demonstrated the involvement of growth factors, such as epidermal growth factor (EGF) and neurotensin in the 5-LOX-mediated tumor progression in prostate cancer [22,23]. Recent studies with 5-LOX siRNA [10] and specific blocker of 5-LOX [24] revealed the relation of this gene with the tumor cell proliferation.<span typeof="mw:Entity" id="mwEDI"> </span>... Meclofenamate sodium (MS) is known for its anti-inflammatory activity, and apart from this, Boctor et al. [37] reported that it caused reduction in the formation of 5-HETE in human leucocytes when used. MS can thus be considered a dual inhibitor of 5-LOX and COX pathways of arachidonic acid cascade. Further investigation with this substance revealed that it could interfere with the LT receptors in the lung carcinoma [38]. In a recent study, a group of scientists have shown the effect of MS on prostate cancer cells both in vitro and in vivo [39], and their result suggests a profound reduction in the tumor growth and cancer metastasis.<span typeof="mw:Entity" id="mwEDM"> </span>... While the commonly used inhibitors produced strong cytotoxicity, notably, zileuton, the only commercialized 5-LOX inhibitor, failed to induce an anti-proliferative or cytotoxic response in all other types of tumor cells where 5-LOX was in inactive state (e.g. HeLa cells); however, where 5-LOX was in active state, zileuton could effectively inhibit progression, as in case of prostate cancer.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Acta+Biochim.+Biophys.+Sin.+%28Shanghai%29&amp;rft.atitle=5-lipoxygenase+antagonist+therapy%3A+a+new+approach+towards+targeted+cancer+chemotherapy&amp;rft.volume=45&amp;rft.issue=9&amp;rft.pages=%3Cspan+class%3D%22nowrap%22%3E709-%3C%2Fspan%3E719&amp;rft.date=2013-09&amp;rft_id=info%3Adoi%2F10.1093%2Fabbs%2Fgmt064&amp;rft_id=info%3Apmid%2F23752617&amp;rft.au=Bishayee+K%2C+Khuda-Bukhsh+AR&amp;rfr_id=info%3Asid%2Far.wikipedia.org%3A%D8%B3%D8%B1%D8%B7%D8%A7%D9%86+%D8%A7%D9%84%D8%A8%D8%B1%D9%88%D8%B3%D8%AA%D8%A7%D8%AA%D8%A7" class="Z3988" about="#mwt689" id="mwEDQ"></span></span></li>
<li about="#cite_note-179" id="cite_note-179" data-mw-footnote-number="179"><span class="mw-cite-backlink" id="mwEDU"><a href="./سرطان_البروستاتا#cite_ref-179" rel="mw:referencedBy" id="mwEDY"><span class="mw-linkback-text" id="mwEDc">↑</span></a></span> <span id="mw-reference-text-cite_note-179" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r70318604" about="#mwt698" typeof="mw:Extension/templatestyles mw:Transclusion" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"استشهاد بدورية محكمة","href":"./قالب:استشهاد_بدورية_محكمة"},"params":{"مؤلف":{"wt":"Linja MJ, Savinainen KJ, Saramäki OR, Tammela TL, Vessella RL, Visakorpi T"},"عنوان":{"wt":"Amplification and overexpression of androgen receptor gene in hormone-refractory prostate cancer"},"صحيفة":{"wt":"Cancer Research"},"المجلد":{"wt":"61"},"العدد":{"wt":"9"},"صفحات":{"wt":"3550–5"},"تاريخ":{"wt":"May 2001"},"pmid":{"wt":"11325816"},"مسار":{"wt":"https://cancerres.aacrjournals.org/content/61/9/3550.long"},"مسار أرشيف":{"wt":"https://web.archive.org/web/20200308175758/https://cancerres.aacrjournals.org/content/61/9/3550.long"},"تاريخ أرشيف":{"wt":"2020-03-08"}},"i":0}}]}' id="mwEDg"/><cite id="CITEREFLinja_MJ,_Savinainen_KJ,_Saramäki_OR,_Tammela_TL,_Vessella_RL,_Visakorpi_T2001" class="citation journal cs1" about="#mwt698">Linja MJ, Savinainen KJ, Saramäki OR, Tammela TL, Vessella RL, Visakorpi T (مايو 2001). <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20200308175758/https://cancerres.aacrjournals.org/content/61/9/3550.long" class="external text" id="mwEDk">"Amplification and overexpression of androgen receptor gene in hormone-refractory prostate cancer"</a>. <i id="mwEDo">Cancer Research</i>. ج.<span typeof="mw:Entity" id="mwEDs"> </span>61 ع.<span typeof="mw:Entity" id="mwEDw"> </span>9: <span class="nowrap" id="mwED0">3550–</span>5. <a rel=