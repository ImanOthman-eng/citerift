{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:citerift:schema:investigation:v1:report",
  "title": "CITERIFT Stage 04 investigation report manifest, version 3",
  "description": "The Stage 04 report (SPEC 11.1): a pure function of the committed fold at ASSEMBLE. It is exported only when VERIFY passes, so only the two successful terminal states exist here: COMPLETED, or NEEDS_RESOLUTION with outcome partial (F-16). FAILED, STALE and CORRUPT investigations export no report (S-9.7); this schema has no representation for them. There is no free-text summary and no field meaning 'clean', 'safe' or 'no retracted citations' (S-7.7). Several Stage 02 events per paper stay here; v1 investigation records (schemas/contracts/v1, unchanged) are separate projections. Version 3 (owner decision D-054) is a manifest graph: this small object names its claims, observations and positive works by ordered content-addressed chunks and its evidence by the committed evidence batches. The durable report is the whole graph; Investigation Memory checks every node on append and on open and VERIFY proves it, so no part can be silently omitted. Versions 1 and 2 were never released and are not migrated.",
  "x-citerift-version": "3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "investigation_key",
    "investigation_id",
    "root",
    "terminal_state",
    "outcome",
    "article_summary",
    "limitations",
    "identities",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "urn:citerift:schema:investigation:v1:report"
    },
    "schema_version": {
      "description": "Unknown versions fail closed.",
      "const": "3.0.0"
    },
    "investigation_key": {
      "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
    },
    "investigation_id": {
      "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/investigation_uuid"
    },
    "root": {
      "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/root"
    },
    "terminal_state": {
      "description": "The lifecycle state the investigation enters when VERIFY passes (it is FAILED otherwise, and the report is not exported). NEEDS_RESOLUTION exactly when a question is open.",
      "enum": [
        "COMPLETED",
        "NEEDS_RESOLUTION"
      ]
    },
    "outcome": {
      "description": "S-9.7: partial when the extraction is partial, a claim is LOOKUP_UNAVAILABLE or a question is open; otherwise completed.",
      "enum": [
        "completed",
        "partial"
      ]
    },
    "article_summary": {
      "description": "Counts only (S-7.7). Nothing is derived from absent claims. claims_by_class and open_questions are functions of the claims component and are checked against it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims_by_class",
        "open_questions",
        "snapshot_id"
      ],
      "properties": {
        "claims_by_class": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/claim_class"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "open_questions": {
          "description": "The number of claim entries that carry an open question (S-7.6).",
          "type": "integer",
          "minimum": 0
        },
        "snapshot_id": {
          "$ref": "urn:citerift:schema:retraction:v1:common#/$defs/snapshot_id"
        }
      }
    },
    "limitations": {
      "description": "Stable limitation codes. A closed list, so that no limitation can state a global negative.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CHECKED_SOURCES_ONLY",
          "EXTRACTION_PARTIAL",
          "LOOKUP_UNAVAILABLE_FOR_SOME_CANDIDATES",
          "OPEN_QUESTIONS",
          "MARKERS_NOT_INTERPRETED",
          "OBSERVATION_ROLE_IDENTIFIERS_NOT_DECIDED",
          "UNSTRUCTURED_TEXT_AS_STAGE03_DEFINES"
        ]
      },
      "contains": {
        "const": "CHECKED_SOURCES_ONLY"
      }
    },
    "identities": {
      "description": "The input identity vector (SPEC 10.3) that replay and staleness compare, including the effective configuration with the D-042 live-ACQUIRE bound.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_key",
        "extraction",
        "index",
        "stage04",
        "config",
        "config_digest"
      ],
      "properties": {
        "request_key": {
          "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/request_key"
        },
        "extraction": {
          "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/extraction_identity"
        },
        "index": {
          "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/index_identity"
        },
        "stage04": {
          "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/stage04_identity"
        },
        "config": {
          "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/config"
        },
        "config_digest": {
          "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "description": "D-042: the live bound is part of the identity of a live-capture investigation and absent for a retained bundle.",
          "if": {
            "properties": {
              "request_key": {
                "required": [
                  "wiki",
                  "revision_id"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "properties": {
                  "live_acquire_bound": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "config": {
                "properties": {
                  "live_acquire_bound": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "observations",
        "positive_works",
        "evidence"
      ],
      "properties": {
        "claims": {
          "description": "The claim entries (SPEC 11.1): each holds the claim, its decision, its question or null, its unit anchor and its checked sources. Ordered by unit source byte offset, then the canonical encoding of the candidate keys, then claim id: ordered content-addressed report chunks (urn:citerift:schema:investigation:v1:report-chunk, part claims), each with its item count. Chunks are cut by the byte ceiling of SPEC 8.8 and hold the items in the order named here.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "count",
            "chunks"
          ],
          "properties": {
            "order": {
              "const": "unit-byte-start/candidate-keys/claim-id/1"
            },
            "count": {
              "description": "The total number of items; equals the sum of the chunk counts.",
              "type": "integer",
              "minimum": 0
            },
            "chunks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chunk",
                  "count"
                ],
                "properties": {
                  "chunk": {
                    "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "observations": {
          "description": "The committed observations, in journal commit order: ordered content-addressed report chunks (urn:citerift:schema:investigation:v1:report-chunk, part observations), each with its item count. Chunks are cut by the byte ceiling of SPEC 8.8 and hold the items in the order named here.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "count",
            "chunks"
          ],
          "properties": {
            "order": {
              "const": "commit/1"
            },
            "count": {
              "description": "The total number of items; equals the sum of the chunk counts.",
              "type": "integer",
              "minimum": 0
            },
            "chunks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chunk",
                  "count"
                ],
                "properties": {
                  "chunk": {
                    "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "positive_works": {
          "description": "The works with positive claims (S-7.7), ordered by the canonical encoding of work: ordered content-addressed report chunks (urn:citerift:schema:investigation:v1:report-chunk, part positive_works), each with its item count. Chunks are cut by the byte ceiling of SPEC 8.8 and hold the items in the order named here.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "count",
            "chunks"
          ],
          "properties": {
            "order": {
              "const": "work/1"
            },
            "count": {
              "description": "The total number of items; equals the sum of the chunk counts.",
              "type": "integer",
              "minimum": 0
            },
            "chunks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chunk",
                  "count"
                ],
                "properties": {
                  "chunk": {
                    "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "evidence": {
          "description": "The investigation's committed evidence (S-12.1), by reference to its committed evidence batches (owner decision D-053), in commit order; nothing is copied (D-054). Each claim names its own evidence by its evidence set (D-047).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "count",
            "batches"
          ],
          "properties": {
            "order": {
              "const": "commit/evidence-batch/1"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "batches": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "batch",
                  "count"
                ],
                "properties": {
                  "batch": {
                    "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "F-16: NEEDS_RESOLUTION is never represented as COMPLETED. An identity conflict or source contradiction routes to resolution and opens a question (W-8). (D-054: a question is open exactly when article_summary.open_questions is at least 1.)",
      "if": {
        "properties": {
          "article_summary": {
            "properties": {
              "open_questions": {
                "minimum": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "terminal_state": {
            "const": "NEEDS_RESOLUTION"
          },
          "outcome": {
            "const": "partial"
          },
          "limitations": {
            "contains": {
              "const": "OPEN_QUESTIONS"
            }
          }
        }
      },
      "else": {
        "properties": {
          "terminal_state": {
            "const": "COMPLETED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "article_summary": {
            "properties": {
              "claims_by_class": {
                "required": [
                  "LOOKUP_UNAVAILABLE"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "partial"
          },
          "limitations": {
            "contains": {
              "const": "LOOKUP_UNAVAILABLE_FOR_SOME_CANDIDATES"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identities": {
            "properties": {
              "extraction": {
                "properties": {
                  "status": {
                    "const": "partial"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "partial"
          },
          "limitations": {
            "contains": {
              "const": "EXTRACTION_PARTIAL"
            }
          }
        }
      }
    },
    {
      "description": "S-9.7 is an equivalence: outcome is partial exactly when the extraction is partial, a claim is LOOKUP_UNAVAILABLE or a question is open. With items 0 to 2 this rules out a partial outcome without a cause.",
      "if": {
        "properties": {
          "outcome": {
            "const": "partial"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "identities": {
                "properties": {
                  "extraction": {
                    "properties": {
                      "status": {
                        "const": "partial"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "identities"
            ]
          },
          {
            "properties": {
              "article_summary": {
                "properties": {
                  "claims_by_class": {
                    "required": [
                      "LOOKUP_UNAVAILABLE"
                    ]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "article_summary": {
                "properties": {
                  "open_questions": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "description": "The OPEN_QUESTIONS limitation appears only when a question is open.",
      "if": {
        "properties": {
          "limitations": {
            "contains": {
              "const": "OPEN_QUESTIONS"
            }
          }
        },
        "required": [
          "limitations"
        ]
      },
      "then": {
        "properties": {
          "article_summary": {
            "properties": {
              "open_questions": {
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "description": "This limitation appears only when a claim is LOOKUP_UNAVAILABLE.",
      "if": {
        "properties": {
          "limitations": {
            "contains": {
              "const": "LOOKUP_UNAVAILABLE_FOR_SOME_CANDIDATES"
            }
          }
        },
        "required": [
          "limitations"
        ]
      },
      "then": {
        "properties": {
          "article_summary": {
            "properties": {
              "claims_by_class": {
                "required": [
                  "LOOKUP_UNAVAILABLE"
                ]
              }
            }
          }
        }
      }
    },
    {
      "description": "This limitation appears only when the extraction is partial.",
      "if": {
        "properties": {
          "limitations": {
            "contains": {
              "const": "EXTRACTION_PARTIAL"
            }
          }
        },
        "required": [
          "limitations"
        ]
      },
      "then": {
        "properties": {
          "identities": {
            "properties": {
              "extraction": {
                "properties": {
                  "status": {
                    "const": "partial"
                  }
                }
              }
            }
          }
        },
        "required": [
          "identities"
        ]
      }
    }
  ],
  "$defs": {
    "claim_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "decision",
        "question",
        "unit",
        "checked_sources"
      ],
      "properties": {
        "claim": {
          "$ref": "urn:citerift:schema:investigation:v1:claim"
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision_id",
            "disposition"
          ],
          "properties": {
            "decision_id": {
              "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
            },
            "disposition": {
              "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/disposition"
            }
          }
        },
        "question": {
          "description": "The open question of a routed claim (S-7.6); null otherwise.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question_id",
                "kind"
              ],
              "properties": {
                "question_id": {
                  "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
                },
                "kind": {
                  "enum": [
                    "identity_conflict",
                    "source_conflict"
                  ]
                }
              }
            }
          ]
        },
        "unit": {
          "description": "The Stage 03 unit and its source anchor (S-12.1). Stage 03 is authoritative for the span; unit_span_sha256 is derived by Stage 04 from the retained Stage 03 source artifact, SHA-256(source_artifact_bytes[byte_start:byte_end]) (owner decision D-043). It is not a Stage 03 field.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit_id",
            "byte_start",
            "byte_end",
            "unit_span_sha256"
          ],
          "properties": {
            "unit_id": {
              "$ref": "urn:citerift:schema:wiki:v1:extraction#/$defs/id"
            },
            "byte_start": {
              "type": "integer",
              "minimum": 0
            },
            "byte_end": {
              "type": "integer",
              "minimum": 0
            },
            "unit_span_sha256": {
              "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
            }
          }
        },
        "checked_sources": {
          "description": "The sources the deciding lookup checked (Stage 02 lookup result). Required for NOT_FOUND_IN_CHECKED_SOURCES, so that the report says which sources were checked (CP-6).",
          "$ref": "urn:citerift:schema:retraction:v1:lookup-result#/properties/checked_sources"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim": {
                "properties": {
                  "class": {
                    "enum": [
                      "RETRACTED_WORK_CITED",
                      "CONCERN_CITED",
                      "CORRECTION_CITED",
                      "REINSTATED_WORK_CITED"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "properties": {
                  "disposition": {
                    "const": "REPORT_FINDING"
                  }
                }
              },
              "question": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim": {
                "properties": {
                  "class": {
                    "const": "NOT_FOUND_IN_CHECKED_SOURCES"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "properties": {
                  "disposition": {
                    "const": "REPORT_NOT_FOUND"
                  }
                }
              },
              "question": {
                "type": "null"
              },
              "checked_sources": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim": {
                "properties": {
                  "class": {
                    "const": "IDENTITY_CONFLICT"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "properties": {
                  "disposition": {
                    "const": "ROUTE_NEEDS_RESOLUTION"
                  }
                }
              },
              "question": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "identity_conflict"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim": {
                "properties": {
                  "class": {
                    "const": "CONTRADICTION_IN_SOURCES"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "properties": {
                  "disposition": {
                    "const": "ROUTE_NEEDS_RESOLUTION"
                  }
                }
              },
              "question": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "source_conflict"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim": {
                "properties": {
                  "class": {
                    "enum": [
                      "UNRESOLVED_IDENTITY",
                      "UNRESOLVED_IDENTIFIER",
                      "UNRESOLVED_STATUS",
                      "NOTICE_CITED"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "properties": {
                  "disposition": {
                    "const": "ABSTAIN"
                  }
                }
              },
              "question": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim": {
                "properties": {
                  "class": {
                    "const": "LOOKUP_UNAVAILABLE"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "properties": {
                  "disposition": {
                    "const": "ABSTAIN_UNAVAILABLE"
                  }
                }
              },
              "question": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim": {
                "properties": {
                  "class": {
                    "enum": [
                      "UNUSED_DEFINITION",
                      "UNRESOLVED_USE",
                      "NO_IDENTIFIER"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "properties": {
                  "disposition": {
                    "const": "OUT_OF_SCOPE"
                  }
                }
              },
              "question": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "observation_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blob",
        "obs_kind"
      ],
      "properties": {
        "blob": {
          "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
        },
        "obs_kind": {
          "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/obs_kind"
        }
      },
      "description": "A committed observation, in journal commit order."
    },
    "positive_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "classes",
        "claim_ids"
      ],
      "properties": {
        "work": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "doi": {
              "$ref": "urn:citerift:schema:retraction:v1:common#/$defs/doi_key"
            },
            "pmid": {
              "$ref": "urn:citerift:schema:retraction:v1:common#/$defs/pmid_key"
            }
          }
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "RETRACTED_WORK_CITED",
              "CONCERN_CITED",
              "CORRECTION_CITED",
              "REINSTATED_WORK_CITED"
            ]
          }
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:citerift:schema:investigation:v1:common#/$defs/sha256"
          }
        }
      },
